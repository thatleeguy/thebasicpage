---
import Demo from "../../../layouts/Demo.astro";
import TradeMark from "../../../components/TradeMark.astro";
import { TRADES, type Trade } from "../../../data/trades";

// One template, thirteen businesses, built in the same idiom as the newsletter
// and podcast demos: centred, generous, and built out of soft elevated cards
// rather than hairline boxes. The earlier version leaned on borders and a fake
// map and read like a template. This one leads with a drawn mark and lets the
// headline be the biggest thing on the page.
export function getStaticPaths() {
	return TRADES.map((t) => ({ params: { trade: t.slug }, props: { t } }));
}

interface Props {
	t: Trade;
}
const { t } = Astro.props;
const telHref = `tel:+1${t.phone.replace(/\D/g, "")}`;

// Only businesses that travel to the customer get a place in the kicker. A
// shop saying "local and nearby" tells you nothing, so it just says the trade.
const place =
	t.areaOrHours.mode === "area" ? t.areaOrHours.items[0].split(/\s+and\s+/i)[0] : null;
const kicker = place ? `${t.trade} · around ${place}` : t.trade;
---

<Demo
	title={`${t.business} · ${t.trade} demo site`}
	description={`Sample one-page website for a ${t.trade.toLowerCase()}, built by The Basic Page. ${t.business} is a fictional business used to demonstrate the design.`}
	business={t.business}
	theme="realestate"
>
	<Fragment slot="head">
		<link rel="preload" href="/fonts/sora.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin />
	</Fragment>

	<main class="sv" style={`--brand:${t.brand}; --tint:${t.tint}`}>
		<section class="hero">
			<TradeMark slug={t.slug} size={76} />
			<p class="wordmark">{t.business}</p>
			<p class="kicker">{kicker}</p>

			<h1>{t.heroHeadline}</h1>
			<p class="lede">{t.heroSub}</p>

			<div class="cta">
				<a class="btn btn--lg" href={telHref}>
					{t.ctaPrimary}
					<span class="btn__sub">{t.phone}</span>
				</a>
				<a class="btn btn--lg btn--quiet" href="#quote">Request a quote</a>
			</div>
			<p class="note">{t.ctaNote}</p>

			<ul class="trust">
				{t.trust.map((x) => <li>{x}</li>)}
			</ul>
		</section>

		<section class="stats">
			{
				t.stats.map((s) => (
					<div>
						<strong>{s.value}</strong>
						<span>{s.label}</span>
					</div>
				))
			}
		</section>

		<section class="block">
			<h2>What we do</h2>
			<div class="grid grid--2">
				{
					t.services.map((s) => (
						<article class="card">
							<h3>{s.name}</h3>
							<p>{s.blurb}</p>
							{s.price && <p class="card__price">{s.price}</p>}
						</article>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>{t.areaOrHours.heading}</h2>
			<div class="card card--wide">
				{
					t.areaOrHours.mode === "area" ? (
						<ul class="places">
							{t.areaOrHours.items.map((i) => (
								<li>{i}</li>
							))}
						</ul>
					) : (
						<ul class="hours">
							{t.areaOrHours.items.map((i) => {
								const [d, ...rest] = i.split(/\s*·\s*/);
								return (
									<li>
										<span>{d}</span>
										<i></i>
										<strong>{rest.join(" · ") || " "}</strong>
									</li>
								);
							})}
						</ul>
					)
				}
				<p class="card__note">{t.areaOrHours.note}</p>
			</div>
		</section>

		<section class="block">
			<h2>What people say</h2>
			<div class="grid grid--3">
				{
					t.reviews.map((r) => (
						<figure class="card">
							<div class="stars" aria-label="5 out of 5">
								{[0, 1, 2, 3, 4].map(() => (
									<svg viewBox="0 0 20 20" aria-hidden="true">
										<path
											fill="currentColor"
											d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"
										/>
									</svg>
								))}
							</div>
							<blockquote>{r.quote}</blockquote>
							<figcaption>
								<strong>{r.name}</strong>
								<span>{r.detail}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<section class="block" id="quote">
			<div class="close">
				<h2>{t.closing.headline}</h2>
				<p class="close__lede">{t.closing.blurb}</p>

				<a class="btn btn--lg btn--onbrand" href={telHref}>
					{t.ctaPrimary}
					<span class="btn__sub">{t.phone}</span>
				</a>

				<form class="qform" id="qform" novalidate>
					<label class="sr-only" for="q-name">Your name</label>
					<input id="q-name" placeholder="Your name" autocomplete="name" required />
					<label class="sr-only" for="q-contact">Phone or email</label>
					<input id="q-contact" placeholder="Phone or email" required />
					<label class="sr-only" for="q-msg">What do you need?</label>
					<textarea id="q-msg" rows="3" placeholder="What do you need?"></textarea>
					<button class="btn btn--onbrand" type="submit">Send it over</button>
				</form>
				<p class="qform__msg" id="qmsg" role="status" hidden></p>
			</div>
		</section>
	</main>

	<!-- Thumb-reachable call button on a phone, which is where nearly every one
	     of these calls actually starts. Hidden once there is room for the hero
	     buttons to stay in view. -->
	<a class="callbar" href={telHref} style={`--brand:${t.brand}`}>
		<span>{t.ctaPrimary}</span>
		<strong>{t.phone}</strong>
	</a>

	<style>
		@font-face {
			font-family: "Sora";
			src: url("/fonts/sora.woff2") format("woff2");
			font-weight: 400 700;
			font-display: swap;
		}
		@font-face {
			font-family: "DM Sans";
			src: url("/fonts/dmsans.woff2") format("woff2");
			font-weight: 400 700;
			font-display: swap;
		}

		/* --brand and --tint come from data and are contrast-checked: white on
		   brand and ink on tint both clear AA. Everything else is derived, so a
		   new trade needs two hex values and nothing more. */
		.sv {
			--ink: #14202c;
			--body: #56646f;
			--line: #e9edf1;
			--surface: #ffffff;
			/* 72%, not less. Below roughly this the tile stops carrying the white
			   icon strokes at 3:1, and a lighter mix fails white text outright,
			   which is why the closing card ramps brand to brand-deep instead of
			   starting from the lift. */
			--brand-lift: color-mix(in srgb, var(--brand) 72%, white);
			--brand-deep: color-mix(in srgb, var(--brand) 82%, black);
			--shadow: 0 1px 2px rgb(20 32 44 / 0.05), 0 10px 26px rgb(20 32 44 / 0.06);
			--shadow-lift: 0 2px 6px rgb(20 32 44 / 0.1), 0 18px 40px rgb(20 32 44 / 0.14);

			font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
			color: var(--body);
			background:
				radial-gradient(56rem 30rem at 50% -16%, var(--tint) 0%, transparent 72%),
				var(--surface);
			font-size: 1.0625rem;
			line-height: 1.62;
			padding: clamp(3.5rem, 8vw, 5.5rem) 1.5rem clamp(3rem, 6vw, 4.5rem);
		}

		h1,
		h2,
		h3 {
			font-family: "Sora", ui-sans-serif, system-ui, sans-serif;
			color: var(--ink);
			font-weight: 600;
			letter-spacing: -0.03em;
			line-height: 1.12;
			text-wrap: balance;
		}
		p {
			text-wrap: pretty;
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* --- Hero --- */
		.hero {
			max-width: 42rem;
			margin-inline: auto;
			text-align: center;
			display: grid;
			justify-items: center;
		}

		.wordmark {
			font-family: "Sora", sans-serif;
			font-weight: 600;
			font-size: 1.0625rem;
			color: var(--ink);
			letter-spacing: -0.02em;
			margin-top: 1.375rem;
		}

		.kicker {
			font-size: 0.6875rem;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			font-weight: 700;
			color: var(--brand);
			margin-top: 0.35rem;
		}

		h1 {
			font-size: clamp(2.125rem, 5.4vw, 3.375rem);
			letter-spacing: -0.042em;
			margin-top: 1.5rem;
		}

		.lede {
			font-size: 1.125rem;
			margin-top: 1.125rem;
			max-width: 36rem;
		}

		.cta {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.75rem;
			margin-top: 2rem;
		}

		.note {
			font-size: 0.875rem;
			margin-top: 0.875rem;
		}

		.trust {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem;
			list-style: none;
			padding: 0;
			margin-top: 2rem;
		}
		.trust li {
			font-size: 0.8125rem;
			background: var(--surface);
			border: 1px solid var(--line);
			border-radius: 100px;
			padding: 0.4rem 0.85rem;
			box-shadow: 0 1px 2px rgb(20 32 44 / 0.04);
		}
		.trust li::before {
			content: "";
			display: inline-block;
			width: 0.55rem;
			height: 0.3rem;
			margin-right: 0.5rem;
			border-left: 2px solid var(--brand);
			border-bottom: 2px solid var(--brand);
			rotate: -45deg;
			translate: 0 -0.15em;
		}

		/* --- Buttons --- */
		.btn {
			display: inline-flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.1rem;
			background: var(--brand);
			color: #fff;
			font-family: "Sora", sans-serif;
			font-weight: 600;
			font-size: 0.9375rem;
			padding: 0.8rem 1.25rem;
			border: 0;
			border-radius: 11px;
			text-decoration: none;
			cursor: pointer;
			box-shadow: var(--shadow);
			transition:
				translate 140ms ease,
				box-shadow 140ms ease,
				background-color 140ms ease;
		}
		.btn:hover {
			background: var(--brand-deep);
			color: #fff;
			translate: 0 -2px;
			box-shadow: var(--shadow-lift);
		}
		.btn--lg {
			font-size: 1.0625rem;
			padding: 0.95rem 1.6rem;
		}
		.btn__sub {
			font-family: "DM Sans", sans-serif;
			font-weight: 400;
			font-size: 0.75rem;
			opacity: 0.88;
		}
		/* Secondary, and it should look it. With a shadow it read as a second
		   primary and split the hero's attention in half. */
		.btn--quiet {
			background: transparent;
			color: var(--ink);
			border: 1px solid var(--line);
			box-shadow: none;
		}
		.btn--quiet:hover {
			background: var(--surface);
			color: var(--ink);
			box-shadow: var(--shadow);
		}
		.btn--onbrand {
			background: #fff;
			color: var(--ink);
		}
		.btn--onbrand:hover {
			background: #fff;
			color: var(--ink);
		}

		/* --- Stats --- */
		.stats {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			max-width: 42rem;
			margin: clamp(3rem, 6vw, 4rem) auto 0;
			gap: 1rem;
			text-align: center;
			padding: 1.5rem 1rem;
			background: var(--surface);
			border-radius: 16px;
			box-shadow: var(--shadow);
		}
		.stats strong {
			display: block;
			font-family: "Sora", sans-serif;
			font-size: clamp(1.375rem, 3.4vw, 1.875rem);
			color: var(--brand);
			font-weight: 600;
			letter-spacing: -0.03em;
		}
		.stats span {
			font-size: 0.8125rem;
		}

		/* --- Blocks --- */
		.block {
			max-width: 58rem;
			margin: clamp(3.25rem, 7vw, 5rem) auto 0;
		}
		h2 {
			font-size: clamp(1.5rem, 3.2vw, 2rem);
			text-align: center;
			margin-bottom: 1.875rem;
		}

		.grid {
			display: grid;
			gap: 1rem;
		}
		@media (min-width: 44rem) {
			.grid--2 {
				grid-template-columns: repeat(2, 1fr);
			}
			.grid--3 {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		.card {
			margin: 0;
			background: var(--surface);
			border-radius: 16px;
			padding: 1.5rem;
			box-shadow: var(--shadow);
		}
		.card--wide {
			max-width: 42rem;
			margin-inline: auto;
		}
		.card h3 {
			font-size: 1.0625rem;
		}
		.card p {
			margin-top: 0.45rem;
			font-size: 0.9375rem;
			line-height: 1.58;
		}
		.card__price {
			font-family: "Sora", sans-serif;
			font-weight: 600;
			font-size: 0.8125rem;
			color: var(--brand);
			margin-top: 0.75rem !important;
		}
		.card__note {
			margin-top: 1.25rem !important;
			font-size: 0.875rem;
			color: var(--body);
		}

		/* --- Places / hours --- */
		.places {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			list-style: none;
			padding: 0;
		}
		.places li {
			font-size: 0.9375rem;
			background: var(--tint);
			color: var(--ink);
			border-radius: 100px;
			padding: 0.4rem 0.9rem;
		}

		.hours {
			list-style: none;
			padding: 0;
			display: grid;
			gap: 0.65rem;
		}
		.hours li {
			display: flex;
			align-items: baseline;
			gap: 0.6rem;
			font-size: 0.9375rem;
		}
		.hours i {
			flex: 1;
			height: 0;
			border-bottom: 2px dotted var(--line);
		}
		.hours strong {
			color: var(--ink);
			font-weight: 600;
			white-space: nowrap;
		}

		/* --- Reviews --- */
		.stars {
			display: flex;
			gap: 2px;
			color: #e0a33a;
			margin-bottom: 0.7rem;
		}
		.stars svg {
			width: 14px;
			height: 14px;
		}
		.card blockquote {
			margin: 0;
			font-size: 0.9375rem;
			line-height: 1.6;
		}
		.card figcaption {
			margin-top: 1rem;
			font-size: 0.8125rem;
		}
		.card figcaption strong {
			color: var(--ink);
		}
		.card figcaption span {
			display: block;
			opacity: 0.85;
		}

		/* --- Close --- */
		.close {
			background: linear-gradient(155deg, var(--brand), var(--brand-deep));
			border-radius: 22px;
			padding: clamp(2.25rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
			text-align: center;
			color: #fff;
			box-shadow: var(--shadow-lift);
			max-width: 42rem;
			margin-inline: auto;
		}
		.close h2 {
			color: #fff;
			margin-bottom: 0;
		}
		.close__lede {
			margin: 0.875rem auto 0;
			max-width: 30rem;
			color: rgb(255 255 255 / 0.94);
		}
		.close .btn {
			margin-top: 1.75rem;
		}

		.qform {
			display: grid;
			gap: 0.625rem;
			margin-top: 1.75rem;
			text-align: left;
		}
		@media (min-width: 34rem) {
			.qform {
				grid-template-columns: 1fr 1fr;
			}
			.qform textarea,
			.qform button {
				grid-column: 1 / -1;
			}
		}
		.qform input,
		.qform textarea {
			font: inherit;
			font-size: 1rem;
			padding: 0.8rem 0.9rem;
			border-radius: 11px;
			border: 1px solid rgb(255 255 255 / 0.34);
			background: rgb(255 255 255 / 0.16);
			color: #fff;
			width: 100%;
		}
		.qform input::placeholder,
		.qform textarea::placeholder {
			color: rgb(255 255 255 / 0.78);
		}
		.qform input:focus-visible,
		.qform textarea:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 1px;
		}
		.qform button {
			box-shadow: none;
		}
		.qform__msg {
			margin-top: 0.875rem;
			font-weight: 600;
			color: var(--ink);
			text-align: center;
		}

		/* --- Sticky call bar, phones only --- */
		.callbar {
			position: fixed;
			left: 0.75rem;
			right: 0.75rem;
			bottom: 0.75rem;
			z-index: 20;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.05rem;
			background: var(--brand);
			color: #fff;
			font-family: "Sora", sans-serif;
			font-weight: 600;
			text-decoration: none;
			padding: 0.75rem 1rem;
			border-radius: 13px;
			box-shadow: 0 6px 20px rgb(20 32 44 / 0.3);
		}
		.callbar strong {
			font-family: "DM Sans", sans-serif;
			font-weight: 400;
			font-size: 0.8125rem;
			opacity: 0.9;
		}
		@media (min-width: 46rem) {
			.callbar {
				display: none;
			}
		}
	</style>

	<script is:inline>
		// Demo only. A real build points this at the owner's inbox.
		(function () {
			var f = document.getElementById("qform");
			var msg = document.getElementById("qmsg");
			if (!f) return;
			f.addEventListener("submit", function (e) {
				e.preventDefault();
				var name = f.querySelector("#q-name").value.trim();
				var contact = f.querySelector("#q-contact").value.trim();
				msg.hidden = false;
				msg.textContent =
					name && contact
						? "Thanks " + name + ", we will be in touch today. (Demo form, nothing was sent.)"
						: "Pop your name and a phone number or email in and we will get back to you.";
				if (name && contact) f.reset();
			});
		})();
	</script>
</Demo>
