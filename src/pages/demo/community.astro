						<span>Hello<em>GTA</em></span>
					</a>
					<p class="foot__blurb">
						A small directory of people worth calling in the Greater Toronto Area, and an email about
						what is happening on your street.
					</p>
				</div>
				<nav aria-label="Footer">
					<h3>The site</h3>
					<a href="#dispatch">What’s in the Dispatch</a>
					<a href="#directory">The directory</a>
					<a href="#areas">Neighbourhoods</a>
					<a href="#listed">Get listed</a>
				</nav>
				<div>
					<h3>Get in touch</h3>
					<a href="mailto:hello@hellogta.ca">hello@hellogta.ca</a>
					<p class="foot__blurb">
						Realtors are registered with RECO. Mortgage agents and brokers are licensed by FSRA. We check
						both.
					</p>
				</div>
			</div>
		</footer>
	</div>

	<style>
		@font-face {
			font-family: "Gabarito";
			src: url("/fonts/gabarito-400-900.woff2") format("woff2");
			font-weight: 400 900;
			font-display: swap;
		}
		@font-face {
			font-family: "DM Sans";
			src: url("/fonts/dmsans.woff2") format("woff2");
			font-weight: 400 700;
			font-display: swap;
		}

		/* --- Palette --------------------------------------------------------
		   Warm cream and near-black, with one hot accent doing all the pointing.
		   Every pair below was measured:
		     ink on paper        17.6:1
		     muted on paper       5.8:1
		     ink on flame         4.7:1   (so flame carries INK text, never white)
		     white on flame-dk    5.2:1   (so buttons darken the flame first)
		     ink on butter       14.7:1
		     flame-lt on ink      7.1:1
		     dim on ink           8.1:1
		   The photographs are almost all blue, green and grey, which is the whole
		   reason the accent is orange: it never has to compete with them. */
		.gta {
			--paper: #fffaf3;
			--card: #ffffff;
			--ink: #191410;
			--muted: #6b6259;
			--line: #ece2d4;
			--flame: #e0512f;
			--flame-dk: #c2401d;
			--flame-lt: #ff7a52;
			--butter: #fbe4b8;
			--mint: #e2eee4;
			--dim: #b8ab9c;
			--r: 18px;
			--shadow: 0 1px 2px rgb(25 20 16 / 0.05), 0 18px 40px -18px rgb(25 20 16 / 0.22);
			--shadow-lg: 0 2px 4px rgb(25 20 16 / 0.06), 0 34px 70px -24px rgb(25 20 16 / 0.3);

			background: var(--paper);
			color: var(--ink);
			font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
			font-size: 1.0625rem;
			line-height: 1.62;
			/* Warm light falling in from the top left, so the page is brightest
			   exactly where the headline is. */
			background-image:
				radial-gradient(70rem 40rem at 8% -8%, #fff2dd 0%, transparent 62%),
				radial-gradient(52rem 34rem at 96% 4%, #ffe9e0 0%, transparent 60%);
			background-repeat: no-repeat;
			overflow-x: clip;
		}

		.wrap {
			max-width: 74rem;
			margin-inline: auto;
			padding-inline: clamp(1.25rem, 4vw, 2.5rem);
		}

		.sec {
			padding-block: clamp(4rem, 9vw, 7rem);
		}

		h1,
		h2,
		h3,
		.wordmark {
			font-family: "Gabarito", ui-sans-serif, system-ui, sans-serif;
			font-weight: 700;
			letter-spacing: -0.025em;
			line-height: 1.05;
			text-wrap: balance;
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* --- Eyebrow --------------------------------------------------------- */
		.eyebrow {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--flame-dk);
		}
		.eyebrow--dark {
			color: var(--flame-lt);
		}
		.eyebrow__pip {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: currentColor;
			/* A slow pulse on one 7px dot. It is the only thing on the page that
			   moves by itself, which is why it reads as "live" rather than as noise. */
			animation: pip 2.6s ease-in-out infinite;
		}
		@keyframes pip {
			0%,
			100% {
				box-shadow: 0 0 0 0 currentColor;
				opacity: 1;
			}
			70% {
				box-shadow: 0 0 0 6px transparent;
				opacity: 0.75;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.eyebrow__pip {
				animation: none;
			}
		}

		/* --- Buttons --------------------------------------------------------- */
		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
			font-family: "Gabarito", sans-serif;
			font-weight: 600;
			font-size: 0.9375rem;
			letter-spacing: -0.01em;
			text-decoration: none;
			padding: 0.7rem 1.25rem;
			border-radius: 100px;
			border: 1px solid transparent;
			background: var(--ink);
			color: var(--paper);
			transition:
				transform 140ms ease,
				background-color 140ms ease,
				box-shadow 140ms ease;
		}
		.btn:hover {
			transform: translateY(-1px);
		}
		.btn--sm {
			padding: 0.5rem 1rem;
			font-size: 0.875rem;
		}
		.btn--flame {
			background: var(--flame-dk);
			color: #fff;
			box-shadow: 0 10px 24px -10px rgb(194 64 29 / 0.7);
		}
		.btn--flame:hover {
			background: #ab3616;
		}
		.btn--ink {
			background: var(--ink);
			color: var(--paper);
		}
		.btn--quiet {
			background: transparent;
			color: var(--ink);
			border-color: var(--line);
		}
		.btn--quiet:hover {
			border-color: var(--ink);
		}

		/* --- Top bar --------------------------------------------------------- */
		.topbar {
			position: sticky;
			top: 0;
			z-index: 20;
			display: flex;
			align-items: center;
			gap: 1.5rem;
			max-width: 74rem;
			margin-inline: auto;
			padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
		}
		/* Blur only the bar's own strip, so the photography behind it stays sharp
		   and the bar never reads as a grey slab over a bright page. */
		.topbar::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background: rgb(255 250 243 / 0.82);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--line);
		}

		.wordmark {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 1.25rem;
			font-weight: 800;
			color: var(--ink);
			text-decoration: none;
			letter-spacing: -0.03em;
		}
		.wordmark em {
			font-style: normal;
			color: var(--flame-dk);
		}
		.wordmark__dot {
			width: 0.7em;
			height: 0.7em;
			border-radius: 50% 50% 50% 2px;
			background: var(--flame);
			transform: rotate(-8deg);
		}

		.topnav {
			display: none;
			gap: 1.5rem;
			margin-left: auto;
			font-size: 0.9375rem;
		}
		.topnav a {
			color: var(--muted);
			text-decoration: none;
			padding-block: 0.25rem;
			border-bottom: 2px solid transparent;
		}
		.topnav a:hover {
			color: var(--ink);
			border-color: var(--flame);
		}
		@media (min-width: 60rem) {
			.topnav {
				display: flex;
			}
		}
		.topbar .btn {
			margin-left: auto;
		}
		@media (min-width: 60rem) {
			.topbar .btn {
				margin-left: 0;
			}
		}

		/* --- Hero ------------------------------------------------------------
		   Two columns that deliberately do not line up: the copy sits high, the
		   photography runs past the bottom of it. On narrow screens the art
		   stacks under and keeps its overlap. */
		.hero {
			max-width: 74rem;
			margin-inline: auto;
			padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
			display: grid;
			gap: clamp(2.5rem, 6vw, 4rem);
			align-items: start;
		}
		@media (min-width: 62rem) {
			.hero {
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
				gap: 3.5rem;
			}
		}

		h1 {
			margin-top: 1rem;
			font-size: clamp(2.5rem, 6.2vw, 4.25rem);
			font-weight: 800;
		}

		.lede {
			margin-top: 1.25rem;
			max-width: 34rem;
			font-size: 1.125rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		.ticks {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem 1.25rem;
			list-style: none;
			padding: 0;
			margin-top: 1.125rem;
			font-size: 0.875rem;
			color: var(--muted);
		}
		.ticks li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}
		.ticks li::before {
			content: "";
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--flame);
		}

		/* --- Signup ---------------------------------------------------------- */
		.signup__slot {
			margin-top: 1.75rem;
			max-width: 29rem;
		}
		.signup {
			display: flex;
			gap: 0.4rem;
			background: var(--card);
			border: 1px solid var(--line);
			border-radius: 100px;
			padding: 0.35rem 0.35rem 0.35rem 0.4rem;
			box-shadow: var(--shadow);
		}
		.signup input {
			flex: 1 1 auto;
			min-width: 0;
			font: inherit;
			font-size: 1rem;
			padding: 0.65rem 0.9rem;
			border: 0;
			background: transparent;
			color: var(--ink);
			border-radius: 100px;
		}
		.signup input::placeholder {
			color: #948a7f;
		}
		.signup input:focus-visible {
			outline: 2px solid var(--flame-dk);
			outline-offset: -1px;
		}
		.signup button {
			flex: none;
			font-family: "Gabarito", sans-serif;
			font-weight: 600;
			font-size: 0.9375rem;
			padding: 0.7rem 1.25rem;
			border: 0;
			border-radius: 100px;
			background: var(--flame-dk);
			color: #fff;
			cursor: pointer;
			transition: background-color 140ms ease;
		}
		.signup button:hover {
			background: #ab3616;
		}
		.signup--dark {
			background: rgb(255 255 255 / 0.1);
			border-color: rgb(255 255 255 / 0.28);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			box-shadow: none;
		}
		.signup--dark input {
			color: #fff;
		}
		.signup--dark input::placeholder {
			color: #d6cec6;
		}
		.signup--dark input:focus-visible {
			outline-color: #fff;
		}
		.signup__msg {
			margin-top: 0.75rem;
			font-size: 0.9375rem;
			font-weight: 600;
		}

		/* --- Hero art -------------------------------------------------------- */
		.hero__art {
			position: relative;
			padding-bottom: 3rem;
		}
		.shot {
			margin: 0;
			border-radius: 24px;
			overflow: hidden;
			background: var(--line);
		}
		.shot img {
			width: 100%;
			height: auto;
			object-fit: cover;
		}
		.shot--main {
			box-shadow: var(--shadow-lg);
			/* A degree and a half. Enough to look pinned up rather than laid out,
			   not enough to read as a mistake. */
			rotate: -1.5deg;
		}
		.shot--house {
			position: absolute;
			right: -0.5rem;
			bottom: 0;
			width: min(52%, 15rem);
			border: 6px solid var(--paper);
			border-radius: 20px;
			box-shadow: var(--shadow-lg);
			rotate: 3deg;
		}
		.pin {
			position: absolute;
			left: -0.5rem;
			bottom: 2.5rem;
			width: min(66%, 17.5rem);
			background: var(--butter);
			border-radius: 14px;
			padding: 0.9rem 1.05rem;
			box-shadow: var(--shadow);
			rotate: -2.5deg;
		}
		.pin__when {
			font-family: "Gabarito", sans-serif;
			font-size: 0.6875rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--flame-dk);
		}
		.pin__what {
			margin-top: 0.35rem;
			font-size: 0.9375rem;
			line-height: 1.4;
			text-wrap: pretty;
		}
		/* Below this the three pieces stop overlapping and stack. Overlap needs
		   room to overlap into; on a phone the pin was simply covering the house.
		   They keep their tilts, inset a little so the corners never touch the
		   edge of the screen. */
		@media (max-width: 34rem) {
			.hero__art {
				display: grid;
				gap: 0.9rem;
				padding-bottom: 0;
			}
			.shot--house {
				position: static;
				width: calc(100% - 1.25rem);
				margin-inline: auto;
				rotate: 1.5deg;
			}
			.shot--house img {
				width: 100%;
			}
			.pin {
				position: static;
				width: calc(100% - 1.25rem);
				margin-inline: auto;
				rotate: -1.5deg;
			}
		}

		/* --- Strip ----------------------------------------------------------- */
		.strip {
			background: var(--ink);
			color: var(--dim);
		}
		.strip p {
			max-width: 74rem;
			margin-inline: auto;
			padding: 1.1rem clamp(1.25rem, 4vw, 2.5rem);
			font-size: 0.9375rem;
			text-wrap: pretty;
		}
		.strip strong {
			color: #fff;
			font-weight: 600;
		}

		/* --- Section heads --------------------------------------------------- */
		.sechead {
			max-width: 40rem;
			margin-bottom: clamp(2rem, 4vw, 3rem);
		}
		.sechead h2 {
			margin-top: 0.875rem;
			font-size: clamp(1.9rem, 4.2vw, 2.9rem);
		}
		.sechead__sub {
			margin-top: 0.875rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		/* --- What's in it ---------------------------------------------------- */
		.sections {
			display: grid;
			gap: clamp(1.5rem, 3vw, 2rem);
		}
		@media (min-width: 40rem) {
			.sections {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (min-width: 68rem) {
			.sections {
				grid-template-columns: repeat(4, 1fr);
			}
			/* Drop every other card half a step. The row reads as a hand of cards
			   rather than a bar chart. */
			.sect:nth-child(even) {
				margin-top: 2.25rem;
			}
		}
		.sect__photo {
			position: relative;
			border-radius: var(--r);
			overflow: hidden;
			background: var(--line);
			aspect-ratio: 14 / 9;
		}
		.sect__photo img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 400ms cubic-bezier(0.2, 0.7, 0.3, 1);
		}
		.sect:hover .sect__photo img {
			transform: scale(1.04);
		}
		.sect__num {
			position: absolute;
			left: 0.75rem;
			bottom: 0.75rem;
			font-family: "Gabarito", sans-serif;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			background: var(--butter);
			color: var(--ink);
			padding: 0.2rem 0.55rem;
			border-radius: 100px;
		}
		.sect h3 {
			margin-top: 1.125rem;
			font-size: 1.25rem;
		}
		.sect p {
			margin-top: 0.5rem;
			font-size: 0.9375rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		/* --- Directory ------------------------------------------------------- */
		.dir {
			position: relative;
			background: linear-gradient(180deg, transparent 0 3rem, var(--mint) 3rem 100%);
		}
		@media (min-width: 48rem) {
			.dir {
				background: linear-gradient(180deg, transparent 0 5rem, var(--mint) 5rem 100%);
			}
		}

		.filter {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-bottom: 2rem;
		}
		.filter label {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			font-family: "Gabarito", sans-serif;
			font-weight: 600;
			font-size: 0.9375rem;
			padding: 0.5rem 0.95rem;
			border: 1px solid var(--line);
			border-radius: 100px;
			background: var(--card);
			cursor: pointer;
			user-select: none;
			transition:
				background-color 140ms ease,
				color 140ms ease,
				border-color 140ms ease;
		}
		.filter label span {
			font-size: 0.75rem;
			font-weight: 700;
			color: var(--muted);
			background: var(--paper);
			border-radius: 100px;
			padding: 0.05rem 0.4rem;
		}
		.filter label:hover {
			border-color: var(--ink);
		}

		#f-all:checked ~ .wrap .filter label[data-on="all"],
		#f-agent:checked ~ .wrap .filter label[data-on="agent"],
		#f-broker:checked ~ .wrap .filter label[data-on="broker"] {
			background: var(--ink);
			color: var(--paper);
			border-color: var(--ink);
		}
		#f-all:checked ~ .wrap .filter label[data-on="all"] span,
		#f-agent:checked ~ .wrap .filter label[data-on="agent"] span,
		#f-broker:checked ~ .wrap .filter label[data-on="broker"] span {
			background: rgb(255 255 255 / 0.16);
			color: #fff;
		}
		/* The real input is off-screen, so its focus ring has to be drawn on the
		   label the keyboard user is actually looking at. */
		#f-all:focus-visible ~ .wrap .filter label[data-on="all"],
		#f-agent:focus-visible ~ .wrap .filter label[data-on="agent"],
		#f-broker:focus-visible ~ .wrap .filter label[data-on="broker"] {
			outline: 3px solid var(--flame-dk);
			outline-offset: 2px;
		}

		#f-agent:checked ~ .dir__grid .mem[data-kind="broker"],
		#f-broker:checked ~ .dir__grid .mem[data-kind="agent"] {
			display: none;
		}

		.dir__grid {
			display: grid;
