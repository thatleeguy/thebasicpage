	</style>

	<script is:inline>
		// Demo only. Swapping either form for a beehiiv embed makes this redundant
		// for that form; the script handles however many are left.
		(function () {
			document.querySelectorAll("form[data-signup]").forEach(function (f) {
				var msg = f.parentElement.querySelector("[data-msg]");
				f.addEventListener("submit", function (e) {
					e.preventDefault();
					var input = f.querySelector("input");
					var ok = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(input.value.trim());
					msg.hidden = false;
					msg.textContent = ok
						? "You’re on the list. Sunday, 7am. (Demo form — nothing was sent.)"
						: "That email doesn’t look right. Have another go.";
					if (ok) f.reset();
				});
			});
		})();
	</script>
