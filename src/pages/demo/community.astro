				</p>

				<div class="signup__slot">
					<form class="signup signup--dark" data-signup novalidate>
						<label class="sr-only" for="email-close">Email address</label>
						<input
							id="email-close"
							type="email"
							inputmode="email"
							autocomplete="email"
							placeholder="you@example.com"
							required
						/>
						<button type="submit">Subscribe free</button>
					</form>
					<p class="signup__msg" data-msg role="status" hidden></p>
				</div>

				<p class="close__fine">Free. One click to unsubscribe. We do not sell the list.</p>
			</div>
		</section>

		<!-- ------------------------------------------------------------ Footer -->
		<footer class="foot">
			<div class="wrap foot__grid">
				<div>
					<a class="wordmark" href="#top">
