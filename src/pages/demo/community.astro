				grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
				/* The list of what you get is much taller than the photograph.
				   Centring the shorter column stops it hanging from the top with a
				   pool of empty butter underneath it. */
				align-items: center;
