---
import Demo from "../../layouts/Demo.astro";

// HelloGTA — a community directory for the Greater Toronto Area.
//
// Unlike the other pages in /demo, HelloGTA is a REAL business. What is
// placeholder here is everything inside it: the nine members, their phone
// numbers, their photos and the neighbourhood counts. Nobody has bought a
// placement yet, so nothing on this page claims that they have. The demo bar
// at the top says exactly that.
//
// The design brief: a directory is only worth $125 a month to a realtor if the
// page has an audience of its own. So the newsletter is the primary call to
// action in the hero, in the middle, and at the end — the directory is what
// the audience is *for*. Sell the Sunday Dispatch to the public; sell the
// public to the members.
//
// Photography is hot-linked from Unsplash, which is free to use and needs no
// attribution. That is deliberate for a template: a client can go live before
// they own a single photograph, and swap them one at a time afterwards. Every
// id below was opened and looked at, not guessed.

const BRAND = "HelloGTA";

/**
 * Which hero to build. Not visitor-facing — this is baked in at build time.
 *
 * "centred" — one enormous headline over one input, on a washed-back
 *   photograph. Everything the page sells sits below the fold on purpose: the
 *   ask is the email address, so nothing competes with it above the line.
 *
 * "framed" — copy on the left, a pinned-up cluster of framed photographs on
 *   the right, with a card showing what is in this Sunday's issue. Slower to
 *   read and it pushes the signup down, but it shows the product and the
 *   neighbourhood in the first screen rather than describing them.
 *
 * Neither is better. "centred" converts a visitor who already knows what this
 * is; "framed" is the one to run when the traffic is cold.
 */
const HERO: "centred" | "framed" = "centred";

/**
 * Unsplash source URL. `auto=format` serves AVIF/WebP to browsers that take
 * them, so these are much smaller than the JPEG the id implies.
 */
const img = (id: string, w: number, h: number) =>
	`https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&h=${h}&q=72`;

/** 1x/2x srcset for the same crop. */
const img2x = (id: string, w: number, h: number) =>
	`${img(id, w, h)} 1x, ${img(id, w * 2, h * 2)} 2x`;

// ---------------------------------------------------------------------------
// Numbers
// ---------------------------------------------------------------------------
// Leave a value as an empty string and the thing that would have shown it does
// not render. This is the same rule as CONTACT.phone on the main site: a
// directory whose whole pitch is "we tell you the real number" cannot open with
// an invented subscriber count. Fill these in from the mailing list dashboard
// the week you launch, and not before.
const NUMBERS = {
	/** Confirmed subscribers, e.g. "1,240". */
	subscribers: "",
	/** Neighbourhoods with at least one member, e.g. "22". */
	areasCovered: "",
} as const;

const PLACEMENT = {
	price: "$125",
	period: "a month",
	perArea: 2,
} as const;

const DISPATCH = {
	name: "The Sunday Dispatch",
	when: "Sundays at 7am",
	/** Reads as a noun: "in about {read}". */
	read: "five minutes",
	/** Reads as an adjective: "a {adj} email". */
	adj: "five-minute",
};

// ---------------------------------------------------------------------------
// What's in the newsletter
// ---------------------------------------------------------------------------
const SECTIONS = [
	{
		tag: "01",
		title: "What actually sold",
		body: "Every sale that closed in your neighbourhood last week, at the price it closed for, not the price it was listed at. Two lines each. No commentary.",
		photo: "1570129477492-45c003edd2be",
		alt: "A white clapboard house with a wide front porch",
	},
	{
		tag: "02",
		title: "Where rates landed",
		body: "The five-year fixed and the variable that GTA brokers were actually writing on Friday afternoon, and whether that is up or down on the week.",
		photo: "1554224155-6726b3ff858f",
		alt: "Mortgage paperwork and a calculator on a desk",
	},
	{
		tag: "03",
		title: "Open houses worth a Sunday",
		body: "Not all of them — the dozen we would go to, with one sentence on why. Members' open houses are in here, marked as theirs so you know.",
		photo: "1560448204-e02f11c3d0e2",
		alt: "A bright living room with large windows",
	},
	{
		tag: "04",
		title: "One street, walked properly",
		body: "Each week somebody walks a single neighbourhood and writes it up: the schools, the parking, the coffee, and the thing you only learn by living there.",
		photo: "1414235077428-338989a2e8c0",
		alt: "A table of food at a neighbourhood restaurant",
	},
];

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------
// PLACEHOLDERS. Every person below is invented and every photo is a stock
// portrait. Phone numbers use the 555-01xx range, which is reserved for fiction
// and cannot ring a real person — same rule as src/data/trades.ts.
//
// Replace a row when somebody actually signs, and delete the rows you have not
// sold yet rather than leaving a full-looking directory that isn't.
type Member = {
	kind: "agent" | "broker";
	name: string;
	firm: string;
	photo: string;
	areas: string[];
	line: string;
	langs: string;
	phone: string;
	site: string;
	since: string;
	/** RECO for realtors, FSRA for mortgage brokers. Both are Ontario regulators. */
	checked: string;
};

const MEMBERS: Member[] = [
	{
		kind: "agent",
		name: "Priya Raman",
		firm: "Sales representative, Bayview & Co.",
		photo: "1573496359142-b8d87734a5a2",
		areas: ["Leaside", "Davisville"],
		line: "Fourteen years on the same six streets. I will tell you when a house is priced to start a war, and I will tell you when it isn't worth the war.",
		langs: "English, Tamil",
		phone: "(416) 555-0142",
		site: "priyaraman.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "agent",
		name: "Daniel Okonkwo",
		firm: "Broker, Lakeshore Realty",
		photo: "1507003211169-0a1dd7228f2d",
		areas: ["The Beaches", "Riverside"],
		line: "I grew up on Kingston Road and I still coach at the same rink. If you want to know which basements flood, ask me before you ask the inspector.",
		langs: "English, Igbo",
		phone: "(416) 555-0118",
		site: "danielokonkwo.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "agent",
		name: "Marta Kowalczyk",
		firm: "Sales representative, Credit River Group",
		photo: "1580489944761-15a19d654956",
		areas: ["Port Credit", "Lorne Park"],
		line: "Most of my work is people moving out of the city and getting the commute wrong. I would rather talk you out of the wrong street than sell you one.",
		langs: "English, Polish",
		phone: "(905) 555-0176",
		site: "martakowalczyk.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "agent",
		name: "Ken Abbott",
		firm: "Broker of record, Abbott & Reid",
		photo: "1472099645785-5658abf4ff4e",
		areas: ["Whitby", "Brooklin"],
		line: "Twenty-six years east of the city. I answer my own phone and I do not have a team, so the person who lists your house is the person who shows it.",
		langs: "English",
		phone: "(905) 555-0133",
		site: "kenabbott.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "agent",
		name: "Sofia Almeida",
		firm: "Sales representative, Humber West",
		photo: "1544005313-94ddf0286df2",
		areas: ["Bloor West Village", "Etobicoke"],
		line: "First-time buyers, mostly. I will sit in your kitchen with a spreadsheet and no pressure, and if the answer is wait another year, that is the answer.",
		langs: "English, Portuguese",
		phone: "(416) 555-0159",
		site: "sofiaalmeida.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "agent",
		name: "Nadia Farrow",
		firm: "Sales representative, Rouge Valley Realty",
		photo: "1438761681033-6461ffad8d80",
		areas: ["Unionville", "Markham"],
		line: "I sell the older parts of Markham, where every second house has been added onto twice. I know which additions were permitted and which ones were not.",
		langs: "English, Cantonese",
		phone: "(905) 555-0107",
		site: "nadiafarrow.ca",
		since: "Member since 2026",
		checked: "RECO registered",
	},
	{
		kind: "broker",
		name: "Jasleen Bhatti",
		firm: "Mortgage agent, Level One Financial",
		photo: "1494790108377-be9c29b29330",
		areas: ["Peel", "Halton"],
		line: "Self-employed files are most of my week. If two lenders have said no because of how your income looks on paper, I am the third call, not the first.",
		langs: "English, Punjabi, Hindi",
		phone: "(905) 555-0191",
		site: "jasleenbhatti.ca",
		since: "Member since 2026",
		checked: "FSRA licensed",
	},
	{
		kind: "broker",
		name: "Curtis Yee",
		firm: "Principal broker, Northbound Mortgage",
		photo: "1560250097-0b93528c311a",
		areas: ["Toronto", "York Region"],
		line: "I send you the rate sheet I am actually looking at, including the lender I am not recommending and the reason why. Renewals are half of what I do.",
		langs: "English, Mandarin",
		phone: "(416) 555-0164",
		site: "northboundmortgage.ca",
		since: "Member since 2026",
		checked: "FSRA licensed",
	},
	{
		kind: "broker",
		name: "Owen Mbeki",
		firm: "Mortgage agent, Harbour Lending",
		photo: "1519085360753-af0119f7cbe7",
		areas: ["Durham", "East Toronto"],
		line: "Newcomer files and thin credit files. I will tell you in the first ten minutes whether the answer is yes, no, or six months of paperwork away.",
		langs: "English, Swahili, French",
		phone: "(905) 555-0128",
		site: "harbourlending.ca",
		since: "Member since 2026",
		checked: "FSRA licensed",
	},
];

const agents = MEMBERS.filter((m) => m.kind === "agent");
const brokers = MEMBERS.filter((m) => m.kind === "broker");

// ---------------------------------------------------------------------------
// Neighbourhoods
// ---------------------------------------------------------------------------
// `open: true` means nobody has bought that area yet. Showing the gaps is the
// point: it is honest, and it is the only scarcity argument that works on a
// realtor reading this page.
const AREAS = [
	{
		name: "Leaside & Davisville",
		photo: "1570129477492-45c003edd2be",
		alt: "A white house with a covered front porch",
		open: false,
	},
	{
		name: "The Beaches",
		photo: "1507992781348-310259076fe0",
		alt: "The Toronto skyline seen across the water at sunset",
		open: false,
	},
	{
		name: "Bloor West Village",
		photo: "1441986300917-64674bd600d8",
		alt: "The inside of a small independent shop",
		open: false,
	},
	{
		name: "Port Credit",
		photo: "1449844908441-8829872d2607",
		alt: "A house at the end of a tree-lined driveway in autumn",
		open: false,
	},
	{
		name: "Maple & Vaughan",
		photo: "1605276374104-dee2a0ed3cd6",
		alt: "A brick suburban house with a double garage",
		open: true,
	},
	{
		name: "Old Oakville",
		photo: "1576941089067-2de3c901e126",
		alt: "A white cottage with a red roof and a flower box",
		open: true,
	},
	{
		name: "Unionville & Markham",
		photo: "1568605114967-8130f3a36994",
		alt: "A modern house lit from inside at dusk",
		open: false,
	},
	{
		name: "Downtown & the waterfront",
		photo: "1486325212027-8081e485255e",
		alt: "Downtown Toronto lit up at night, with the CN Tower behind it",
		open: true,
	},
];

// ---------------------------------------------------------------------------
// The placement pitch
// ---------------------------------------------------------------------------
const INCLUDES = [
	{
		h: "Your own phone number, not a lead form",
		p: "Your number, your email and a plain link to your own site. Nothing on this page routes through us, and nothing is sold on.",
	},
	{
		h: `${PLACEMENT.perArea} people per neighbourhood`,
		p: "One realtor and one mortgage broker. When Leaside is taken it is taken, and the only way in is if somebody leaves.",
	},
	{
		h: "No referral fee, ever",
		p: "We do not take a cut of a deal, we do not ask what closed, and we never will. The monthly fee is the entire business model.",
	},
	{
		h: "A paragraph in the Dispatch each month",
		p: "You write it, about your own area, with your name on it. Not an ad — the part of the email people forward to a friend.",
	},
	{
		h: "Your open houses in Sunday's list",
		p: "Marked as yours, in the section people actually read on a Sunday morning, at no extra cost.",
	},
	{
		h: "We check you are registered first",
		p: "RECO for realtors, FSRA for mortgage agents and brokers. If it does not check out you do not go live, which is the reason the badge means anything.",
	},
];
---

<Demo
	title={`${BRAND} · a community directory for the Greater Toronto Area`}
	description="HelloGTA lists one realtor and one mortgage broker per GTA neighbourhood, and sends a five-minute email every Sunday morning about what sold, where rates landed, and which open houses are worth the trip."
	business={BRAND}
	theme="community"
	disclaimer={`${BRAND} is real, but every member, phone number and photograph on this page is a placeholder. Nobody has bought a placement yet.`}
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
		<link rel="preload" href="/fonts/outfit-300-900.woff2" as="font" type="font/woff2" crossorigin />
	</Fragment>

	<div class="gta">
		<!-- ---------------------------------------------------------------- Nav -->
		<header class="topbar">
			<a class="wordmark" href="#top">
				<span class="wordmark__mark" aria-hidden="true">
					<svg viewBox="0 0 32 32">
						<rect width="32" height="32" rx="9" fill="currentColor"></rect>
						<path d="M10 22V10h3.2v4.4h5.6V10H22v12h-3.2v-4.7h-5.6V22z" fill="#fff"></path>
					</svg>
				</span>
				<span>Hello<em>GTA</em></span>
			</a>

			<!-- The segmented dark pill, borrowed wholesale from the reference. -->
			<nav class="pillnav" aria-label="Sections">
				<a href="#dispatch">Dispatch</a>
				<a href="#directory">Directory</a>
				<a href="#areas">Neighbourhoods</a>
				<a href="#listed">Get listed</a>
			</nav>

			<a class="btn btn--blue btn--sm" href="#signup">Subscribe free</a>
		</header>

		<!-- -------------------------------------------------------------- Hero -->
		<!-- Two heroes, one copy block. The wording, the form and the ticks are
		     identical in both, so they are written once and the layout is switched
		     with CSS off data-hero. Only the imagery differs: "centred" gets a
		     washed-back backdrop, "framed" gets the pinned-up cluster. -->
		<section class="hero" data-hero={HERO} id="top">
			{
				HERO === "centred" && (
					/* The reference sits its centred hero on a washed-out photograph of
					   a stadium. Same idea: the page is meant to be image-led, and a
					   plain grey band under the headline would have thrown that away. */
					<img
						class="hero__bg"
						src={img("1517090504586-fde19ea6066f", 1500, 700)}
						width="1500"
						height="700"
						alt=""
						fetchpriority="high"
						decoding="async"
					/>
				)
			}

			<div class="hero__copy">
				<p class="chip chip--blue">
					<span class="chip__pip" aria-hidden="true"></span>{DISPATCH.name} · {DISPATCH.when}
				</p>

				<h1>Who to call, and what actually sold on your street.</h1>

				<p class="lede">
					{BRAND} lists one realtor and one mortgage broker per neighbourhood across the Greater Toronto
					Area — no more than that — and sends a {DISPATCH.adj} email every Sunday morning about what
					changed in yours.
				</p>

				<!--
				SIGNUP.

				Native form, styled to match the page. To go live with beehiiv,
				replace the <form> with their embed iframe and leave the wrapper:

				  <div class="signup__slot">
				    <iframe src="https://embeds.beehiiv.com/YOUR-ID"
				            data-test-id="beehiiv-embed" frameborder="0" scrolling="no"
				            style="width:100%;height:66px;border-radius:999px;background:transparent"></iframe>
				  </div>

				The wrapper owns width and alignment so the embed inherits the layout.
				The same slot takes ConvertKit, Buttondown or Mailchimp. There are two
				of these on the page; both are wired by the one script at the bottom.
				-->
				<div class="signup__slot" id="signup">
					<form class="signup" data-signup novalidate>
						<label class="sr-only" for="email-hero">Email address</label>
						<input
							id="email-hero"
							type="email"
							inputmode="email"
							autocomplete="email"
							placeholder="Your email, for Sunday morning"
							required
						/>
						<button type="submit">
							<span class="sr-only">Subscribe free</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="M4 12h15M13 6l6 6-6 6"
									fill="none"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</form>
					<p class="signup__msg" data-msg role="status" hidden></p>
				</div>

				<ul class="ticks">
					<li>Free</li>
					<li>No spam, no pitch</li>
					<li>One click to unsubscribe</li>
					{NUMBERS.subscribers && <li>{NUMBERS.subscribers} neighbours reading</li>}
				</ul>
			</div>

			{
				HERO === "framed" && (
					<div class="hero__art">
						<figure class="shot shot--main">
							<img
								src={img("1517090504586-fde19ea6066f", 760, 620)}
								srcset={img2x("1517090504586-fde19ea6066f", 760, 620)}
								width="760"
								height="620"
								alt="The CN Tower seen from a park across Toronto harbour on a clear day"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>

						<figure class="shot shot--house">
							<img
								src={img("1605276374104-dee2a0ed3cd6", 340, 250)}
								srcset={img2x("1605276374104-dee2a0ed3cd6", 340, 250)}
								width="340"
								height="250"
								alt="A brick house with a double garage on a quiet suburban street"
								loading="lazy"
								decoding="async"
							/>
						</figure>

						<div class="pin">
							<p class="pin__when">
								<span class="chip__pip" aria-hidden="true" />
								This Sunday, 7am
							</p>
							<p class="pin__what">
								“Eleven sales on Bessborough, and one of them makes no sense. Plus: the variable
								moved.”
							</p>
						</div>
					</div>
				)
			}
		</section>

		<!-- ------------------------------------------------- Popular, TickPick row -->
		<section class="wrap rail">
			<div class="rail__head">
				<h2>Popular neighbourhoods</h2>
				<a class="rail__all" href="#areas">See all</a>
			</div>
			<div class="rail__row">
				{
					AREAS.slice(0, 4).map((a) => (
						<a class="mini" href="#directory">
							<img
								class="mini__thumb"
								src={img(a.photo, 96, 96)}
								srcset={img2x(a.photo, 96, 96)}
								width="96"
								height="96"
								alt=""
								loading="lazy"
								decoding="async"
							/>
							<span class="mini__body">
								<span class="mini__name">{a.name}</span>
								<span class="mini__meta">
									{a.open ? (
										<span class="tag tag--open">Open</span>
									) : (
										<span class="tag">1 realtor · 1 broker</span>
									)}
								</span>
							</span>
							<span class="go" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path
										d="M9 5l7 7-7 7"
										fill="none"
										stroke="currentColor"
										stroke-width="2.6"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
						</a>
					))
				}
			</div>
		</section>

		<!-- ------------------------------------------------------- Bold black box -->
		<section class="wrap">
			<div class="slab">
				<p>
					<strong>Written by people who live here.</strong> Not scraped, not syndicated, and not a portal
					trying to sell your address to four agents at once.
				</p>
			</div>
		</section>

		<!-- ---------------------------------------------------------- Dispatch -->
		<section class="wrap sec" id="dispatch">
			<div class="sechead">
				<h2>Four things, every Sunday, in about {DISPATCH.read}.</h2>
				<p>The same four sections in the same order every week, so you can read the one you came for and close it.</p>
			</div>

			<div class="sections">
				{
					SECTIONS.map((s) => (
						<article class="sect">
							<div class="sect__photo">
								<img
									src={img(s.photo, 560, 380)}
									srcset={img2x(s.photo, 560, 380)}
									width="560"
									height="380"
									alt={s.alt}
									loading="lazy"
									decoding="async"
								/>
								<span class="sect__num">{s.tag}</span>
							</div>
							<div class="sect__body">
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- --------------------------------------------------------- Directory -->
		<!-- The filter is three radio inputs and CSS sibling selectors. No script,
		     which means it works before hydration and on a page with JS off. The
		     inputs must stay ahead of .dir__grid in the DOM for `~` to reach it. -->
		<section class="dir sec" id="directory">
			<input class="fq sr-only" type="radio" name="kind" id="f-all" checked />
			<input class="fq sr-only" type="radio" name="kind" id="f-agent" />
			<input class="fq sr-only" type="radio" name="kind" id="f-broker" />

			<div class="wrap">
				<div class="sechead">
					<h2>{MEMBERS.length} people, and their actual phone numbers.</h2>
					<p>
						One realtor and one mortgage broker per neighbourhood. Calling them calls them — nothing on
						this page goes through us, and no enquiry is ever sold on.
					</p>
				</div>

				<div class="filter" role="group" aria-label="Filter the directory">
					<label for="f-all" data-on="all">Everyone <span>{MEMBERS.length}</span></label>
					<label for="f-agent" data-on="agent">Realtors <span>{agents.length}</span></label>
					<label for="f-broker" data-on="broker">Mortgage brokers <span>{brokers.length}</span></label>
				</div>
			</div>

			<div class="wrap dir__grid">
				{
					MEMBERS.map((m) => (
						<article class="mem" data-kind={m.kind}>
							<div class="mem__top">
								<img
									class="mem__face"
									src={img(m.photo, 128, 128)}
									srcset={img2x(m.photo, 128, 128)}
									width="128"
									height="128"
									alt={m.name}
									loading="lazy"
									decoding="async"
								/>
								<div class="mem__id">
									<h3>{m.name}</h3>
									<p class="mem__firm">{m.firm}</p>
								</div>
