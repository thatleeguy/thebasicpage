	<style>
		@font-face {
			font-family: "Outfit";
			src: url("/fonts/outfit-300-900.woff2") format("woff2");
			font-weight: 300 900;
			font-display: swap;
		}

		/* --- Palette --------------------------------------------------------
		   White page, near-black text, one saturated blue. Measured:
		     ink on white         17.4:1
		     muted on white        5.8:1
		     white on blue-dk      6.1:1   (every button and link)
		     ink on blue          5.9:1   (so the bright blue carries INK, not white)
		     white on blue-lt-end  4.6:1   (the light end of the offer gradient)
		     blue-lt on ink        7.8:1
		   The bright --blue is the one the reference is known for, but white on it
		   is only 2.9:1. So it is used at scale — gradients, chips behind dark
		   text, the mark — and anything carrying white text steps down to
		   --blue-dk. The page still reads blue; it just does not fail. */
		.gta {
			--paper: #ffffff;
			--wash: #f4f6f9;
			--ink: #1a1a1a;
			--muted: #5f6672;
			--line: #e6e9ef;
			--line-dk: #d7dce5;
			--blue: #3399ff;
			--blue-dk: #0f5ec9;
			--blue-dkr: #0b52b8;
			--blue-mid: #1273e0;
			--blue-wash: #e8f2ff;
			--blue-lt: #66b2ff;
			--dim: #a9b0bb;
			--r: 16px;
			--r-lg: 24px;
			--shadow: 0 1px 2px rgb(16 24 40 / 0.04), 0 8px 24px -12px rgb(16 24 40 / 0.18);
			--shadow-lg: 0 2px 6px rgb(16 24 40 / 0.06), 0 28px 60px -28px rgb(16 24 40 / 0.35);

			background: var(--paper);
			color: var(--ink);
			font-family: "Outfit", ui-sans-serif, system-ui, sans-serif;
			font-size: 1rem;
			line-height: 1.6;
			font-weight: 400;
			overflow-x: clip;
		}

		.wrap {
			max-width: 76rem;
			margin-inline: auto;
			padding-inline: clamp(1rem, 3.5vw, 2rem);
		}

		.sec {
			padding-block: clamp(3rem, 6vw, 4.5rem);
		}
		.sec--tight {
			padding-block: 0 clamp(3rem, 6vw, 4.5rem);
		}

		h1,
		h2,
		h3 {
			letter-spacing: -0.02em;
			line-height: 1.1;
			text-wrap: balance;
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* --- Chips ----------------------------------------------------------- */
		.chip {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			font-size: 0.8125rem;
			font-weight: 700;
			padding: 0.35rem 0.8rem;
			border-radius: 999px;
		}
		.chip--blue {
			background: var(--blue-wash);
			color: var(--blue-dk);
		}
		.chip--onblue {
			background: rgb(255 255 255 / 0.16);
			color: #fff;
		}
		.chip--onblack {
			background: rgb(255 255 255 / 0.14);
			color: #fff;
		}
		.chip__pip {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--blue);
			/* The only thing on the page that moves by itself. That scarcity is why
			   it reads as "live" rather than as noise. */
			animation: pip 2.6s ease-in-out infinite;
		}
		@keyframes pip {
			0%,
			100% {
				box-shadow: 0 0 0 0 var(--blue);
				opacity: 1;
			}
			70% {
				box-shadow: 0 0 0 6px transparent;
				opacity: 0.7;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.chip__pip {
				animation: none;
			}
		}

		/* --- Buttons --------------------------------------------------------- */
		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
			font-family: inherit;
			font-weight: 700;
			font-size: 0.9375rem;
			text-decoration: none;
			padding: 0.7rem 1.35rem;
			border-radius: 999px;
			border: 0;
			background: var(--ink);
			color: #fff;
			cursor: pointer;
			transition:
				transform 130ms ease,
				background-color 130ms ease,
				box-shadow 130ms ease;
		}
		.btn:hover {
			transform: translateY(-1px);
		}
		.btn--sm {
			padding: 0.5rem 1.1rem;
			font-size: 0.875rem;
		}
		.btn--blue {
			background: var(--blue-dk);
			box-shadow: 0 8px 20px -10px rgb(15 94 201 / 0.8);
		}
		.btn--blue:hover {
			background: var(--blue-dkr);
		}
		.btn--ink:hover {
			background: #000;
		}
		.btn--white {
			background: #fff;
			color: var(--blue-dkr);
		}
		.btn--white:hover {
			background: var(--blue-wash);
		}

		/* Circular arrow affordance. Straight from the reference — every card on
		   it ends in one, which is most of why the cards read as tappable. */
		.go {
			flex: none;
			display: grid;
			place-items: center;
			width: 30px;
			height: 30px;
			border-radius: 50%;
			background: var(--blue-wash);
			color: var(--blue-dk);
			transition:
				background-color 140ms ease,
				color 140ms ease,
				transform 140ms ease;
		}
		.go svg {
			width: 15px;
			height: 15px;
		}
		.go--sm {
			width: 22px;
			height: 22px;
			background: transparent;
		}
		.go--sm svg {
			width: 13px;
			height: 13px;
		}

		/* --- Top bar --------------------------------------------------------- */
		.topbar {
			position: sticky;
			top: 0;
			z-index: 20;
			display: flex;
			align-items: center;
			gap: 1rem;
			max-width: 76rem;
			margin-inline: auto;
			padding: 0.85rem clamp(1rem, 3.5vw, 2rem);
		}
		.topbar::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background: rgb(255 255 255 / 0.86);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--line);
		}

		.wordmark {
			display: inline-flex;
			align-items: center;
			gap: 0.55rem;
			font-size: 1.3125rem;
			font-weight: 800;
			letter-spacing: -0.035em;
			color: var(--ink);
			text-decoration: none;
		}
		.wordmark__mark {
			flex: none;
			width: 30px;
			height: 30px;
			color: var(--blue-dk);
		}
		.wordmark__mark svg {
			width: 100%;
			height: 100%;
		}
		.wordmark em {
			font-style: normal;
			color: var(--blue-dk);
		}

		/* The segmented dark pill. */
		.pillnav {
			display: none;
			gap: 0.15rem;
			margin-inline: auto;
			padding: 0.25rem;
			background: var(--ink);
			border-radius: 999px;
		}
		.pillnav a {
			font-size: 0.875rem;
			font-weight: 600;
			color: #d5d8de;
			text-decoration: none;
			padding: 0.4rem 0.95rem;
			border-radius: 999px;
			transition:
				background-color 140ms ease,
				color 140ms ease;
		}
		.pillnav a:hover {
			background: #fff;
			color: var(--ink);
		}
		@media (min-width: 62rem) {
			.pillnav {
				display: flex;
			}
		}
		.topbar > .btn {
			margin-left: auto;
		}
		@media (min-width: 62rem) {
			.topbar > .btn {
				margin-left: 0;
			}
		}

		/* --- Hero ------------------------------------------------------------
		   Two layouts off one copy block, switched by data-hero. Everything that
		   is shared lives on .hero; the differences are in the two [data-hero]
		   blocks below. */
		.hero {
			position: relative;
			isolation: isolate;
			padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3.5vw, 2rem) clamp(3rem, 6vw, 4.5rem);
			background:
				radial-gradient(38rem 20rem at 50% -10%, #e8f2ff 0%, transparent 68%),
				linear-gradient(180deg, var(--wash) 0%, #fff 100%);
		}

		/* "centred": one enormous heavy headline over one input. Everything the
		   page sells sits below the fold on purpose — the ask is the email
		   address, so nothing competes with it above the line. */
		.hero[data-hero="centred"] {
			text-align: center;
		}
		.hero[data-hero="centred"] .hero__copy {
			max-width: 52rem;
			margin-inline: auto;
		}

		/* "framed": copy left, a pinned-up cluster of framed photographs right.
		   Slower to read and it pushes the signup down, but it shows the product
		   and the neighbourhood in the first screen rather than describing them. */
		.hero[data-hero="framed"] {
			max-width: 76rem;
			margin-inline: auto;
			display: grid;
			gap: clamp(2.5rem, 5vw, 3.5rem);
			align-items: center;
		}
		@media (min-width: 62rem) {
			.hero[data-hero="framed"] {
				grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
			}
		}
		.hero[data-hero="framed"] h1 {
			margin-inline: 0;
			max-width: 15ch;
			font-size: clamp(2.25rem, 4.6vw, 3.5rem);
		}
		.hero[data-hero="framed"] .lede,
		.hero[data-hero="framed"] .signup__slot {
			margin-inline: 0;
		}
		.hero[data-hero="framed"] .lede {
			max-width: 34rem;
		}
		.hero[data-hero="framed"] .ticks {
			justify-content: flex-start;
		}
		/* The grid texture is aimed at the middle of a centred hero. Off-centre it
		   just smudges one corner, so the framed layout does without it. */
		.hero[data-hero="framed"]::before,
		.hero[data-hero="framed"]::after {
			content: none;
		}

		/* The backdrop photograph is knocked back and then covered by a
		   near-opaque white scrim. Measured across the headline, the worst
		   background the type sits on is 13.8:1. */
		.hero__bg {
			position: absolute;
			inset: 0;
			z-index: -2;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0.55;
		}
		.hero::after {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background: linear-gradient(
				180deg,
				rgb(255 255 255 / 0.7) 0%,
				rgb(255 255 255 / 0.88) 45%,
				rgb(255 255 255 / 0.99) 100%
			);
		}
		/* A faint grid, so the pale band behind the headline has a texture rather
		   than being an empty grey rectangle. */
		.hero::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 0;
			background-image:
				linear-gradient(rgb(15 94 201 / 0.05) 1px, transparent 1px),
				linear-gradient(90deg, rgb(15 94 201 / 0.05) 1px, transparent 1px);
			background-size: 46px 46px;
			mask-image: radial-gradient(38rem 22rem at 50% 30%, #000 0%, transparent 75%);
			-webkit-mask-image: radial-gradient(38rem 22rem at 50% 30%, #000 0%, transparent 75%);
		}
		/* :not(img) matters — this rule has the same specificity as .hero__bg and
		   comes after it, so without the exclusion it would win, drop the backdrop
		   back into flow and push the whole hero down by the height of a
		   full-width photograph. */
		.hero > :not(img) {
			position: relative;
			z-index: 1;
		}

		/* --- Framed hero art -------------------------------------------------
		   Three overlapping pieces: the big shot, a small one in a white frame,
		   and the card saying what is in this Sunday's issue. The tilts are a
		   degree or two — enough to look pinned up rather than laid out, not
		   enough to read as a mistake. */
		.hero__art {
			position: relative;
			padding-bottom: 2.5rem;
		}
		.shot {
			margin: 0;
			border-radius: var(--r-lg);
			overflow: hidden;
			background: var(--wash);
		}
		.shot img {
			width: 100%;
			height: auto;
			object-fit: cover;
		}
		.shot--main {
			box-shadow: var(--shadow-lg);
			rotate: -1.5deg;
		}
		.shot--house {
			position: absolute;
			right: -0.5rem;
			bottom: 0;
			width: min(52%, 15rem);
			border: 6px solid #fff;
			border-radius: 20px;
			box-shadow: var(--shadow-lg);
			rotate: 3deg;
		}
		.pin {
			position: absolute;
			left: -0.5rem;
			bottom: 2rem;
			width: min(66%, 17.5rem);
			background: #fff;
			border: 1px solid var(--line);
			border-radius: 14px;
			padding: 0.85rem 1rem;
			box-shadow: var(--shadow-lg);
			rotate: -2.5deg;
		}
		.pin__when {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			font-size: 0.6875rem;
			font-weight: 800;
			letter-spacing: 0.07em;
			text-transform: uppercase;
			color: var(--blue-dk);
		}
		.pin__what {
			margin-top: 0.35rem;
			font-size: 0.9375rem;
			line-height: 1.4;
			text-wrap: pretty;
		}
		/* Below this the three stop overlapping and stack. Overlap needs room to
		   overlap into; on a phone the card was simply covering the house. They
		   keep their tilts, inset a little so no corner touches the screen edge. */
		@media (max-width: 34rem) {
			.hero__art {
				display: grid;
				gap: 0.9rem;
				padding-bottom: 0;
			}
			.shot--house,
			.pin {
				position: static;
				width: calc(100% - 1.25rem);
				margin-inline: auto;
			}
			.shot--house {
				rotate: 1.5deg;
			}
			.pin {
				rotate: -1.5deg;
			}
		}

		h1 {
			margin: 1.25rem auto 0;
			max-width: 24ch;
			font-size: clamp(2.5rem, 6.2vw, 4.5rem);
			font-weight: 900;
			letter-spacing: -0.035em;
		}

		.lede {
			margin: 1.125rem auto 0;
			max-width: 38rem;
			font-size: 1.0625rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		.ticks {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.35rem 1.25rem;
			list-style: none;
			padding: 0;
			margin-top: 1.25rem;
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--muted);
		}
		.ticks li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}
		.ticks li::before {
			content: "";
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--blue);
		}

		/* --- Signup ---------------------------------------------------------- */
		.signup__slot {
			margin: 2rem auto 0;
			max-width: 30rem;
		}
		.signup {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			background: #fff;
			border: 1px solid var(--line-dk);
			border-radius: 999px;
			padding: 0.4rem 0.4rem 0.4rem 0.5rem;
			box-shadow: var(--shadow);
		}
		.signup input {
			flex: 1 1 auto;
			min-width: 0;
			font: inherit;
			font-size: 1rem;
			padding: 0.7rem 0.9rem;
			border: 0;
			background: transparent;
			color: var(--ink);
			border-radius: 999px;
		}
		.signup input::placeholder {
			color: #8b929e;
		}
		.signup input:focus-visible {
			outline: 2px solid var(--blue-dk);
			outline-offset: -1px;
		}
		.signup button {
			flex: none;
			display: grid;
			place-items: center;
			width: 44px;
			height: 44px;
			border: 0;
			border-radius: 50%;
			background: var(--blue-dk);
			color: #fff;
			cursor: pointer;
			transition:
				background-color 140ms ease,
				transform 140ms ease;
		}
		.signup button svg {
			width: 20px;
			height: 20px;
		}
		.signup button:hover {
			background: var(--blue-dkr);
			transform: scale(1.05);
		}
		.signup--dark {
			background: rgb(255 255 255 / 0.1);
			border-color: rgb(255 255 255 / 0.3);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			box-shadow: none;
		}
		.signup--dark input {
			color: #fff;
		}
		.signup--dark input::placeholder {
			color: #cfd4dc;
		}
		.signup--dark input:focus-visible {
			outline-color: #fff;
		}
		.signup--dark button {
			background: #fff;
			color: var(--ink);
		}
		.signup--dark button:hover {
			background: var(--blue-wash);
		}
		.signup__msg {
			margin-top: 0.75rem;
			font-size: 0.875rem;
			font-weight: 600;
			text-align: center;
		}

		/* --- Popular rail ---------------------------------------------------- */
		.rail {
			padding-top: clamp(2rem, 4vw, 2.75rem);
		}
		.rail__head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 0.875rem;
		}
		.rail__head h2 {
			font-size: 1.125rem;
			font-weight: 700;
		}
		.rail__all {
			font-size: 0.875rem;
			font-weight: 600;
			color: var(--blue-dk);
			text-decoration: none;
		}
		.rail__all:hover {
			text-decoration: underline;
		}
		.rail__row {
			display: grid;
			gap: 0.75rem;
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		}

		.mini {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			background: #fff;
			border: 1px solid var(--line);
			border-radius: 14px;
			padding: 0.6rem 0.75rem;
			text-decoration: none;
			color: inherit;
			box-shadow: 0 1px 2px rgb(16 24 40 / 0.04);
			transition:
				border-color 140ms ease,
				box-shadow 140ms ease,
				transform 140ms ease;
		}
		.mini:hover {
			border-color: var(--blue);
			box-shadow: var(--shadow);
			transform: translateY(-2px);
		}
		.mini:hover .go {
			background: var(--blue-dk);
			color: #fff;
		}
		.mini__thumb {
			flex: none;
			width: 44px;
			height: 44px;
			border-radius: 10px;
			object-fit: cover;
			background: var(--wash);
		}
		.mini__body {
			min-width: 0;
			flex: 1 1 auto;
		}
		.mini__name {
			display: block;
			font-weight: 700;
			font-size: 0.9375rem;
			line-height: 1.25;
		}
		.mini__meta {
			display: block;
			margin-top: 0.15rem;
		}
		.tag {
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--muted);
		}
		.tag--open {
			background: var(--blue);
			color: var(--ink);
			padding: 0.1rem 0.45rem;
			border-radius: 999px;
		}

		/* --- Bold black box -------------------------------------------------- */
		.slab {
			margin-top: clamp(1rem, 2.5vw, 1.75rem);
			background: var(--ink);
			color: var(--dim);
			border-radius: var(--r-lg);
			padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
		}
		.slab strong {
			color: #fff;
			font-weight: 700;
		}
		.slab p {
			max-width: 52rem;
			font-size: 1rem;
			text-wrap: pretty;
		}

		/* --- Section heads --------------------------------------------------- */
		.sechead {
			max-width: 44rem;
			margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		}
		.sechead h2 {
			font-size: clamp(1.75rem, 3.6vw, 2.5rem);
			font-weight: 800;
		}
		.sechead p {
			margin-top: 0.75rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		/* --- What's in it ---------------------------------------------------- */
		.sections {
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		}
		.sect {
			display: flex;
			flex-direction: column;
			background: #fff;
			border: 1px solid var(--line);
			border-radius: var(--r);
			overflow: hidden;
			transition:
				border-color 140ms ease,
				box-shadow 140ms ease,
				transform 140ms ease;
		}
		.sect:hover {
			border-color: var(--blue);
			box-shadow: var(--shadow);
			transform: translateY(-2px);
		}
		.sect__photo {
			position: relative;
			aspect-ratio: 14 / 9;
			background: var(--wash);
		}
		.sect__photo img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.sect__num {
			position: absolute;
			left: 0.7rem;
			top: 0.7rem;
			font-size: 0.75rem;
			font-weight: 800;
			background: var(--blue);
			color: var(--ink);
			padding: 0.15rem 0.5rem;
			border-radius: 999px;
		}
		.sect__body {
			padding: 1rem 1.1rem 1.25rem;
		}
		.sect h3 {
			font-size: 1.0625rem;
			font-weight: 700;
		}
		.sect p {
			margin-top: 0.45rem;
			font-size: 0.9375rem;
			color: var(--muted);
			text-wrap: pretty;
		}

		/* --- Directory ------------------------------------------------------- */
		.dir {
			background: var(--wash);
			border-block: 1px solid var(--line);
		}

		.filter {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-bottom: 1.5rem;
		}
		.filter label {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			font-weight: 700;
			font-size: 0.9375rem;
			padding: 0.5rem 1rem;
			border: 1px solid var(--line-dk);
			border-radius: 999px;
			background: #fff;
			cursor: pointer;
			user-select: none;
			transition:
				background-color 140ms ease,
				color 140ms ease,
				border-color 140ms ease;
		}
		.filter label span {
			font-size: 0.75rem;
			font-weight: 700;
			color: var(--muted);
			background: var(--wash);
			border-radius: 999px;
			padding: 0.05rem 0.4rem;
		}
		.filter label:hover {
			border-color: var(--ink);
		}

		#f-all:checked ~ .wrap .filter label[data-on="all"],
		#f-agent:checked ~ .wrap .filter label[data-on="agent"],
		#f-broker:checked ~ .wrap .filter label[data-on="broker"] {
			background: var(--ink);
			color: #fff;
			border-color: var(--ink);
		}
		#f-all:checked ~ .wrap .filter label[data-on="all"] span,
		#f-agent:checked ~ .wrap .filter label[data-on="agent"] span,
		#f-broker:checked ~ .wrap .filter label[data-on="broker"] span {
			background: rgb(255 255 255 / 0.18);
			color: #fff;
		}
		/* The real input is off-screen, so its focus ring has to be drawn on the
		   label the keyboard user is actually looking at. */
		#f-all:focus-visible ~ .wrap .filter label[data-on="all"],
		#f-agent:focus-visible ~ .wrap .filter label[data-on="agent"],
		#f-broker:focus-visible ~ .wrap .filter label[data-on="broker"] {
			outline: 3px solid var(--blue-dk);
			outline-offset: 2px;
		}

		#f-agent:checked ~ .dir__grid .mem[data-kind="broker"],
		#f-broker:checked ~ .dir__grid .mem[data-kind="agent"] {
			display: none;
		}

		.dir__grid {
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		}

		.mem {
			display: flex;
			flex-direction: column;
			background: #fff;
			border: 1px solid var(--line);
			border-radius: var(--r);
			padding: 1.15rem;
			transition:
				border-color 140ms ease,
				box-shadow 140ms ease,
				transform 140ms ease;
		}
		.mem:hover {
			border-color: var(--blue);
			box-shadow: var(--shadow);
			transform: translateY(-2px);
		}

		.mem__top {
			display: flex;
			gap: 0.8rem;
			align-items: flex-start;
		}
		.mem__face {
			flex: none;
			width: 56px;
			height: 56px;
			border-radius: 12px;
			object-fit: cover;
			background: var(--wash);
		}
		.mem__id {
			min-width: 0;
			flex: 1 1 auto;
		}
		.mem__id h3 {
			font-size: 1.0625rem;
			font-weight: 700;
		}
		.mem__firm {
			margin-top: 0.1rem;
			font-size: 0.8125rem;
			color: var(--muted);
		}
		.mem__kind {
			flex: none;
			font-size: 0.6875rem;
			font-weight: 800;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			background: var(--blue-wash);
			color: var(--blue-dk);
			padding: 0.2rem 0.5rem;
			border-radius: 999px;
		}

		.chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem;
			list-style: none;
			padding: 0;
			margin: 0.9rem 0 0;
		}
		.chips li {
			font-size: 0.75rem;
			font-weight: 600;
			background: var(--wash);
			border: 1px solid var(--line);
			color: var(--ink);
			padding: 0.15rem 0.55rem;
			border-radius: 999px;
		}

		.mem__line {
			margin-top: 0.8rem;
			font-size: 0.9375rem;
			line-height: 1.5;
			color: var(--muted);
			text-wrap: pretty;
		}

		.mem__meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem 1.5rem;
			margin: 0.9rem 0 0;
			padding-top: 0.8rem;
			border-top: 1px solid var(--line);
			font-size: 0.8125rem;
		}
		.mem__meta dt {
			color: var(--muted);
			font-size: 0.6875rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			font-weight: 700;
		}
		.mem__meta dd {
			margin: 0.1rem 0 0;
			font-weight: 600;
		}
		.mem__check {
			display: flex;
			align-items: center;
			gap: 0.3rem;
			color: #12724f;
		}
		.mem__check svg {
			width: 14px;
			height: 14px;
			flex: none;
		}

		.mem__act {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			margin-top: auto;
			padding-top: 1rem;
		}
		.mem__act .btn {
			font-size: 0.875rem;
			padding: 0.55rem 1.1rem;
		}
		.mem__site {
			display: inline-flex;
			align-items: center;
			gap: 0.1rem;
			font-size: 0.875rem;
			font-weight: 600;
			color: var(--blue-dk);
			text-decoration: none;
		}
		.mem__site:hover {
			text-decoration: underline;
		}

		.dir__note {
			margin-top: 1.75rem;
			max-width: 44rem;
			font-size: 0.9375rem;
			color: var(--muted);
			text-wrap: pretty;
		}
		.dir__note a {
			color: var(--blue-dk);
			font-weight: 600;
		}

		/* --- Neighbourhoods -------------------------------------------------- */
		.areas {
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		}
		.area {
			display: flex;
			flex-direction: column;
			background: #fff;
			border: 1px solid var(--line);
			border-radius: var(--r);
			overflow: hidden;
			text-decoration: none;
			color: inherit;
			transition:
				border-color 140ms ease,
				box-shadow 140ms ease,
				transform 140ms ease;
		}
		.area:hover {
			border-color: var(--blue);
			box-shadow: var(--shadow);
			transform: translateY(-2px);
		}
		.area:hover .go {
			background: var(--blue-dk);
			color: #fff;
		}
		.area:focus-visible {
			outline: 3px solid var(--blue-dk);
			outline-offset: 2px;
		}
		.area__pic {
			position: relative;
			aspect-ratio: 7 / 5;
			background: var(--wash);
		}
		.area__pic img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 500ms cubic-bezier(0.2, 0.7, 0.3, 1);
		}
		.area:hover .area__pic img {
			transform: scale(1.04);
		}
		.area__flag {
			position: absolute;
			top: 0.6rem;
			right: 0.6rem;
			font-size: 0.6875rem;
			font-weight: 800;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			background: var(--blue);
			color: var(--ink);
			padding: 0.2rem 0.55rem;
			border-radius: 999px;
		}
		.area__body {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.85rem 0.95rem 0.95rem;
		}
		.area__body h3 {
			font-size: 1rem;
			font-weight: 700;
		}
		.area__body p {
			margin-top: 0.1rem;
			font-size: 0.8125rem;
			color: var(--muted);
		}

		/* --- Offer, the bold blue box ---------------------------------------
		   The gradient's light end is #1273e0, which is the lightest blue that
		   still carries white body text at 4.6:1. Lighten it and the paragraphs
		   inside stop passing. All text in here is white; the hierarchy is size
		   and weight, because every mid-blue tint that reads as "secondary"
		   fails against the light end. */
		.offer {
			display: grid;
			gap: clamp(2rem, 4vw, 3rem);
			align-items: center;
			background: linear-gradient(135deg, var(--blue-dkr) 0%, var(--blue-mid) 100%);
			color: #fff;
			border-radius: var(--r-lg);
			padding: clamp(1.75rem, 4vw, 3rem);
		}
		@media (min-width: 62rem) {
			.offer {
				grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
			}
		}
		.offer h2 {
			margin-top: 0.875rem;
			font-size: clamp(2.75rem, 7vw, 4.5rem);
			font-weight: 900;
			letter-spacing: -0.04em;
		}
		.offer h2 span {
			font-size: 0.28em;
			font-weight: 600;
			letter-spacing: -0.01em;
		}
		.offer__lede {
			margin-top: 0.5rem;
			max-width: 32rem;
			text-wrap: pretty;
		}

		.includes {
			display: grid;
			gap: 1.1rem;
			list-style: none;
			padding: 0;
			margin: 1.75rem 0 0;
		}
		@media (min-width: 34rem) {
			.includes {
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem 2rem;
			}
		}
		.includes li {
			padding-top: 0.75rem;
			border-top: 2px solid rgb(255 255 255 / 0.35);
		}
		.includes h3 {
			font-size: 0.9375rem;
			font-weight: 700;
			line-height: 1.3;
		}
		.includes p {
			margin-top: 0.35rem;
			font-size: 0.875rem;
			text-wrap: pretty;
		}

		.offer__act {
			margin-top: 2rem;
		}
		.offer__act p {
			margin-top: 0.875rem;
			max-width: 26rem;
			font-size: 0.875rem;
		}

		.offer__art {
			margin: 0;
		}
		.offer__art img {
			width: 100%;
			height: auto;
			border-radius: var(--r);
			box-shadow: var(--shadow-lg);
		}
		.offer__art figcaption {
			margin-top: 1.25rem;
			font-size: 0.9375rem;
			text-wrap: pretty;
		}
		.offer__art strong {
			display: block;
			font-size: 1rem;
			font-weight: 700;
			margin-bottom: 0.15rem;
		}

		/* --- Big close, the bold black box ----------------------------------- */
		.close {
			position: relative;
			isolation: isolate;
			overflow: hidden;
			border-radius: var(--r-lg);
			background: var(--ink);
			text-align: center;
			color: #fff;
			padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 4vw, 3rem);
		}
		.close__bg {
			position: absolute;
			inset: 0;
			z-index: -2;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.close::after {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background:
				linear-gradient(180deg, rgb(10 12 16 / 0.5), rgb(10 12 16 / 0.78)),
				radial-gradient(58% 58% at 50% 50%, rgb(10 12 16 / 0.42), transparent);
		}
		.close__inner {
			max-width: 40rem;
			margin-inline: auto;
		}
		.close h2 {
			margin-top: 0.875rem;
			font-size: clamp(1.9rem, 4.6vw, 3rem);
			font-weight: 800;
		}
		.close__sub {
			margin-top: 0.875rem;
			color: #e3e6ea;
			text-wrap: pretty;
		}
		.close__fine {
			margin-top: 1rem;
			font-size: 0.8125rem;
			color: #cbd0d8;
		}

		/* --- Footer ---------------------------------------------------------- */
		.foot {
			background: var(--wash);
			border-top: 1px solid var(--line);
			padding-block: clamp(2.5rem, 5vw, 3.5rem);
		}
		.foot__grid {
			display: grid;
			gap: 2rem;
		}
		@media (min-width: 48rem) {
			.foot__grid {
				grid-template-columns: 1.4fr 1fr 1fr;
				gap: 3rem;
			}
		}
		.foot h3 {
			font-size: 0.75rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--muted);
			font-weight: 700;
			margin-bottom: 0.7rem;
		}
		.foot nav {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
