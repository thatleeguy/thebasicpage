---
import Demo from "../../layouts/Demo.astro";
import Icon from "../../components/ClinicIcon.astro";

// Same layout DNA as dentist.astro (full-bleed bands, serif headline, the
// phone number as the hero's centrepiece), a different trade and a
// different palette, so the two don't read as one template with a colour
// swap. Charcoal and amber instead of navy and green.
const BIZ = "Dunmore Plumbing & Heating";
const PHONE = "(519) 555-0161";
const TEL = `tel:+1${PHONE.replace(/\D/g, "")}`;
const TOWN = "Paris, Ontario";

const SERVICES = [
	{
		icon: "drop",
		name: "Burst & leaking pipes",
		blurb: "We stop the water, dry the area out, and replace the section that failed.",
		tag: "24-hour",
	},
	{
		icon: "wrench",
		name: "Blocked drains",
		blurb: "Snake, camera, or both if the first one does not hold.",
	},
	{
		icon: "flame",
		name: "Water heaters",
		blurb: "Tank or tankless. Most swaps happen the same day, straight off the truck.",
		tag: "Same day",
	},
	{
		icon: "wrench",
		name: "Toilets, taps & fixtures",
		blurb: "The small jobs that turn into a weekend of dripping if you leave them.",
	},
	{
		icon: "flame",
		name: "Heating & furnace plumbing",
		blurb: "Boiler lines and radiators. The pipe side of your heat, not the electrical.",
	},
	{
		icon: "drop",
		name: "Renovation rough-ins",
		blurb: "New bathroom, new kitchen. We do the pipe before the drywall goes up.",
	},
];
---

<Demo
	title={`${BIZ} · plumber demo site`}
	description={`Sample one-page website for a residential plumbing company, built by The Basic Page. ${BIZ} is a fictional business used to demonstrate the design.`}
	business={BIZ}
	theme="realestate"
>
	<Fragment slot="head">
		<link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin />
	</Fragment>

	<div class="cl">
		<header class="topbar">
			<span class="topbar__brand">
				<Icon name="drop" />
				{BIZ}
			</span>
			<a class="topbar__call" href={TEL}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
					/>
				</svg>
				{PHONE}
			</a>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">Emergency &amp; scheduled service · {TOWN} since 2010</p>
				<h1>A burst pipe does not care what time it is. Neither do we.</h1>
				<p class="lede">
					Residential plumbing and heating: leaks, blocked drains, water heaters, and the stuff
					that only breaks on a long weekend. Nights and weekends cost the same as a Tuesday.
				</p>

				<div class="callblock">
					<p class="callblock__label">Call. It is faster than a form at 2am.</p>
					<a class="callblock__number" href={TEL}>{PHONE}</a>
				</div>

				<ul class="pills">
					<li><Icon name="clock" /> 24-hour emergency line</li>
					<li><Icon name="truck" /> Fully stocked trucks</li>
					<li><Icon name="receipt" /> No charge to show up</li>
				</ul>
			</section>

			<section class="band band--dark">
				<div class="info">
					<div>
						<p class="info__label">Where we are</p>
						<p class="info__big">The shop is on Grand River Street.<br />We are almost always in a truck.</p>
						<p class="info__note">{TOWN}, Brant County, and everything between here and Cambridge.</p>
					</div>
					<div>
						<p class="info__label">Office hours</p>
						<dl class="hours">
							<div><dt>Mon to Fri</dt><dd>8:00 am to 5:00 pm</dd></div>
							<div><dt>Sat to Sun</dt><dd>Emergency only</dd></div>
						</dl>
						<p class="info__note">The emergency line answers 24 hours, every day of the year.</p>
					</div>
					<div>
						<p class="info__label">After hours</p>
						<p class="info__body">
							Nights and weekends go through the same number. A real person answers, not a service
							reading from a script.
						</p>
						<a class="btn btn--pale" href="#quote">Get directions to the shop</a>
					</div>
				</div>
			</section>

			<section class="services" id="services">
				<div class="sechead">
					<h2>What we do</h2>
					<p>Ask about anything you do not see here. Most of it, we handle off the truck.</p>
				</div>
				<div class="grid">
					{
						SERVICES.map((s) => (
							<article class="card">
								<Icon name={s.icon} class="card__icon" />
								<h3>{s.name}</h3>
								<p>{s.blurb}</p>
								{s.tag && <span class="tag">{s.tag}</span>}
							</article>
						))
					}
				</div>
				<div class="sechead__cta">
					<a class="btn btn--solid" href={TEL}>Call {PHONE}</a>
					<a class="btn btn--outline" href="#quote">Request a quote</a>
				</div>
			</section>

			<section class="band band--light">
				<div class="differentiator">
					<div>
						<h2>We do not charge you to find out what is wrong.</h2>
						<p>
							A lot of outfits charge a trip fee just to look, then quote you once they are already
							in your basement. We look, we tell you the number, and if you say no thanks, you owe
							us nothing.
						</p>
						<p>
							That is only possible because the trucks carry real stock: water heaters, common
							valves, twenty kinds of fitting. Most jobs get fixed on the first visit instead of a
							second trip to the supply house.
						</p>
						<a class="btn btn--outline" href={TEL}>Call {PHONE}</a>
					</div>
					<figure class="photo">
						<div class="photo__frame" aria-hidden="true"></div>
						<figcaption>
							<strong>One of the trucks, stocked for a full day</strong>
							<span>Twenty kinds of fitting beats one trip to the store.</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="band band--dark" id="quote">
				<div class="honest">
					<h2>We will tell you when it is not worth fixing.</h2>
					<p>
						Sometimes the honest answer is that the water heater has had it, and a repair is
						throwing money at a ten-year-old tank. We will say so, and quote the replacement next to
						the repair so you can see both.
					</p>
					<a class="btn btn--pale" href={TEL}>Call {PHONE}</a>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="foot__grid">
				<div class="foot__brand">
					<span class="topbar__brand">
						<Icon name="drop" />
						{BIZ}
					</span>
					<p>Grand River Street<br />{TOWN}</p>
					<a class="foot__phone" href={TEL}>{PHONE}</a>
					<dl class="hours hours--foot">
						<div><dt>Office</dt><dd>Mon to Fri, 8 to 5</dd></div>
						<div><dt>Emergency</dt><dd>24 hours</dd></div>
					</dl>
				</div>
				<div>
					<p class="foot__label">Services</p>
					<a href="#services">Burst &amp; leaking pipes</a>
					<a href="#services">Blocked drains</a>
					<a href="#services">Water heaters</a>
					<a href="#services">Toilets, taps &amp; fixtures</a>
					<a href="#services">Heating &amp; furnace plumbing</a>
					<a href="#services">Renovation rough-ins</a>
				</div>
				<div>
					<p class="foot__label">Good to know</p>
					<a href={TEL}>Emergency line</a>
					<a href="#quote">Request a quote</a>
					<a href="#services">Service area</a>
					<a href="#quote">Get directions</a>
				</div>
			</div>
		</footer>
	</div>

	<style>
		@font-face {
			font-family: "Fraunces";
			src: url("/fonts/fraunces.woff2") format("woff2");
			font-weight: 500 700;
			font-display: swap;
		}
		@font-face {
			font-family: "DM Sans";
			src: url("/fonts/dmsans.woff2") format("woff2");
			font-weight: 400 700;
			font-display: swap;
		}

		.cl {
			--navy: #11151c;
			--navy-deep: #0a0d12;
			--green: #9a4a0e;
			--green-deep: #73370a;
			--pale-bg: #f5e6d6;
			--band-light: #f3f1ea;
			--ink: #14202c;
			--body: #4d5a67;
			--line: #e4e1da;
			--paper: #ffffff;
			font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
			color: var(--body);
			background: var(--paper);
			font-size: 1.0625rem;
			line-height: 1.62;
		}

		h1,
		h2,
		h3 {
			font-family: "Fraunces", Georgia, serif;
			color: var(--ink);
			font-weight: 600;
			line-height: 1.14;
			letter-spacing: -0.015em;
			text-wrap: balance;
		}
		p {
			text-wrap: pretty;
		}

		/* --- Top bar --- */
		/* Stacked below ~26rem so a longer business name never wraps against
		   the call pill and squeezes it into an odd vertical position. */
		.topbar {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
			padding: 1rem 1.5rem;
			border-bottom: 1px solid var(--line);
		}
		@media (min-width: 26rem) {
			.topbar {
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
			}
		}
		.topbar__brand {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			font-family: "Fraunces", serif;
			font-weight: 600;
			font-size: 1.0625rem;
			color: var(--ink);
		}
		.topbar__brand :global(svg) {
			width: 22px;
			height: 22px;
			color: var(--green);
			flex: none;
		}
		.topbar__call {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: var(--green);
			color: #fff;
			font-weight: 700;
			font-size: 0.9375rem;
			padding: 0.65rem 1.1rem;
			border-radius: 100px;
			text-decoration: none;
			white-space: nowrap;
		}
		.topbar__call:hover {
			background: var(--green-deep);
			color: #fff;
		}
		.topbar__call svg {
			width: 15px;
			height: 15px;
		}

		/* --- Hero --- */
		.hero {
			max-width: 40rem;
			margin-inline: auto;
			text-align: center;
			padding: clamp(3rem, 7vw, 4.5rem) 1.5rem clamp(3.5rem, 7vw, 5rem);
		}
		.eyebrow {
			font-size: 0.75rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			font-weight: 700;
			color: var(--green);
			margin-bottom: 1.25rem;
		}
		h1 {
			font-size: clamp(2rem, 5vw, 2.875rem);
		}
		.lede {
			font-size: 1.0625rem;
			margin-top: 1.125rem;
			max-width: 34rem;
			margin-inline: auto;
		}

		.callblock {
			margin-top: 2.25rem;
		}
		.callblock__label {
			font-size: 0.75rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			font-weight: 700;
			color: var(--body);
			opacity: 0.75;
		}
		.callblock__number {
			display: block;
			font-family: "Fraunces", serif;
			font-weight: 700;
			font-size: clamp(2rem, 7vw, 3rem);
			letter-spacing: -0.01em;
			color: var(--green);
			text-decoration: none;
			margin-top: 0.35rem;
		}
		.callblock__number:hover {
			color: var(--green-deep);
		}

		.pills {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.6rem;
			list-style: none;
			padding: 0;
			margin-top: 1.75rem;
		}
		.pills li {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			background: var(--pale-bg);
			color: var(--green-deep);
			font-weight: 600;
			font-size: 0.875rem;
			padding: 0.5rem 0.95rem;
			border-radius: 100px;
		}
		.pills :global(svg) {
			width: 16px;
			height: 16px;
			flex: none;
		}

		/* --- Bands --- */
		.band {
			padding: clamp(3rem, 6vw, 4.5rem) 1.5rem;
		}
		.band--dark {
			background: linear-gradient(155deg, var(--navy) 0%, var(--navy-deep) 100%);
			color: #c7cbd1;
		}
		.band--light {
			background: var(--band-light);
		}

		.info {
			max-width: 64rem;
			margin-inline: auto;
			display: grid;
			gap: 2.25rem;
		}
		@media (min-width: 46rem) {
			.info {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		.info__label {
			font-size: 0.6875rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			font-weight: 700;
			color: #e0a05a;
			margin-bottom: 0.75rem;
		}
		.info__big {
			font-family: "Fraunces", serif;
			font-size: 1.1875rem;
			color: #fff;
			font-weight: 600;
			line-height: 1.35;
		}
		.info__body {
			font-size: 0.9375rem;
			line-height: 1.55;
			color: #c7cbd1;
		}
		.info__note {
			margin-top: 0.75rem;
			font-size: 0.875rem;
			color: #8f96a1;
		}

		.hours {
			margin: 0;
			display: grid;
			gap: 0.5rem;
		}
		.hours div {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			font-size: 0.9375rem;
		}
		.hours dt {
			color: #8f96a1;
			font-weight: 400;
		}
		.hours dd {
			margin: 0;
			color: #fff;
			font-weight: 600;
		}

		/* --- Buttons --- */
		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-family: "DM Sans", sans-serif;
			font-weight: 700;
			font-size: 0.9375rem;
			padding: 0.8rem 1.4rem;
			border-radius: 10px;
			text-decoration: none;
			margin-top: 1.25rem;
			margin-right: 0.625rem;
		}
		.btn--solid {
			background: var(--green);
			color: #fff;
		}
		.btn--solid:hover {
			background: var(--green-deep);
			color: #fff;
		}
		.btn--pale {
			background: #ecc292;
			color: var(--green-deep);
		}
		.btn--pale:hover {
			background: #f0cda3;
			color: var(--green-deep);
		}
		.btn--outline {
			background: transparent;
			color: var(--ink);
			border: 1.5px solid #c9c3b6;
		}
		.btn--outline:hover {
			background: #fff;
			color: var(--ink);
		}

		/* --- Services --- */
		.services {
			max-width: 64rem;
			margin-inline: auto;
			padding: clamp(3.25rem, 6vw, 5rem) 1.5rem;
			text-align: center;
		}
		.sechead h2 {
			font-size: clamp(1.625rem, 3.2vw, 2.125rem);
		}
		.sechead p {
			margin-top: 0.625rem;
		}
		.sechead__cta {
			margin-top: 2.25rem;
		}

		.grid {
			display: grid;
			gap: 1rem;
			margin-top: 2.25rem;
			text-align: left;
		}
		@media (min-width: 46rem) {
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		.card {
			border: 1px solid var(--line);
			border-radius: 14px;
			padding: 1.5rem;
		}
		.card :global(.card__icon) {
			width: 26px;
			height: 26px;
			color: var(--green);
		}
		.card h3 {
			font-size: 1.0625rem;
			margin-top: 0.875rem;
		}
		.card p {
			font-size: 0.9375rem;
			margin-top: 0.5rem;
		}
		.tag {
			display: inline-block;
			margin-top: 0.875rem;
			background: var(--pale-bg);
			color: var(--green-deep);
			font-size: 0.75rem;
			font-weight: 700;
			padding: 0.3rem 0.65rem;
			border-radius: 100px;
		}

		/* --- Differentiator --- */
		.differentiator {
			max-width: 64rem;
			margin-inline: auto;
			display: grid;
			gap: 2.5rem;
			align-items: center;
		}
		@media (min-width: 50rem) {
			.differentiator {
				grid-template-columns: 1.05fr 0.95fr;
			}
		}
		.differentiator h2 {
			font-size: clamp(1.625rem, 3.2vw, 2.125rem);
		}
		.differentiator p {
			margin-top: 1rem;
			max-width: 34rem;
		}

		.photo__frame {
			aspect-ratio: 4 / 3;
			border-radius: 14px;
			border: 1.5px dashed #c9c3b6;
			background: linear-gradient(155deg, #fff, var(--band-light));
		}
		.photo figcaption {
			margin-top: 0.875rem;
		}
		.photo figcaption strong {
			display: block;
			color: var(--ink);
			font-size: 0.9375rem;
		}
		.photo figcaption span {
			display: block;
			font-size: 0.8125rem;
			margin-top: 0.2rem;
		}

		/* --- Honest band --- */
		.honest {
			max-width: 38rem;
			margin-inline: auto;
			text-align: center;
		}
		.honest h2 {
			color: #fff;
			font-size: clamp(1.625rem, 3.4vw, 2.125rem);
		}
		.honest p {
			margin-top: 1rem;
			color: #c7cbd1;
		}

		/* --- Footer --- */
		.foot {
			background: var(--navy-deep);
			color: #8f96a1;
			padding: clamp(3rem, 6vw, 4rem) 1.5rem 2.5rem;
		}
		.foot__grid {
			max-width: 64rem;
			margin-inline: auto;
			display: grid;
			gap: 2.5rem;
		}
		@media (min-width: 46rem) {
			.foot__grid {
				grid-template-columns: 1.3fr 1fr 1fr;
			}
		}
		.foot .topbar__brand {
			color: #fff;
		}
		.foot__brand p {
			margin-top: 1rem;
			font-size: 0.9375rem;
		}
		.foot__phone {
			display: block;
			margin-top: 0.75rem;
			font-family: "Fraunces", serif;
			font-weight: 700;
			font-size: 1.375rem;
			color: #e0a05a;
			text-decoration: none;
		}
		.hours--foot {
			margin-top: 1.25rem;
			max-width: 14rem;
		}
		.hours--foot dd {
			color: #c7cbd1;
		}
		.foot__label {
			font-size: 0.6875rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			font-weight: 700;
			color: #e0a05a;
			margin-bottom: 1rem;
		}
		.foot a {
			display: block;
			color: #c7cbd1;
			text-decoration: none;
			font-size: 0.9375rem;
			padding-block: 0.4rem;
		}
		.foot a:hover {
			color: #fff;
		}
	</style>
</Demo>
