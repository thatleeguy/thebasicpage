---
// A drawn mark per trade, sitting in a gradient tile. This replaces the emoji
// that used to sit in a header bar: an emoji reads as a placeholder somebody
// never got round to replacing, which is exactly the impression these pages
// cannot afford to give.
//
// All thirteen are line art on the same grid, same stroke weight, same round
// caps, so a set of thirteen businesses still looks like one studio made them.
interface Props {
	slug: string;
	size?: number;
}
const { slug, size = 76 } = Astro.props;
---

<span class="tile" style={`--tile:${size}px`}>
	<svg
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.7"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		{slug === "plumber" && <path d="M12 3.4c3 3.4 5.2 6.5 5.2 9.1a5.2 5.2 0 0 1-10.4 0c0-2.6 2.2-5.7 5.2-9.1Z" />}

		{slug === "electrician" && <path d="M13.6 2.6 7 13h4.2l-.8 8.4L17.4 11h-4.3l.5-8.4Z" />}

		{
			slug === "landscaper" && (
				<g>
					<path d="M20.5 3.8c.6 9.4-3.4 14.7-8.7 14.7a5.5 5.5 0 0 1-5.5-5.5c0-6.3 6.3-9.2 14.2-9.2Z" />
					<path d="M5.5 21c1.4-4.4 4.6-7.9 9.5-10.2" />
				</g>
			)
		}

		{
			slug === "contractor" && (
				<g>
					<path d="M3.6 10.4 12 3.6l8.4 6.8V20a1 1 0 0 1-1 1H4.6a1 1 0 0 1-1-1v-9.6Z" />
					<path d="M9.4 21v-6.2h5.2V21" />
				</g>
			)
		}

		{
			slug === "cleaner" && (
				<g>
					<path d="M10.4 2.6 12 8l5.4 1.6L12 11.2l-1.6 5.4-1.6-5.4L3.4 9.6 8.8 8l1.6-5.4Z" />
					<path d="M17.8 14.2l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z" />
				</g>
			)
		}

		{
			slug === "dog-groomer" && (
				<g>
					<ellipse cx="7.4" cy="8.2" rx="2" ry="2.5" />
					<ellipse cx="12" cy="6.5" rx="2" ry="2.6" />
					<ellipse cx="16.6" cy="8.2" rx="2" ry="2.5" />
					<path d="M12 12.4c3 0 5.4 2.4 5.4 4.7 0 2-1.6 3.3-3.4 3.3-.9 0-1.4-.3-2-.3s-1.1.3-2 .3c-1.8 0-3.4-1.3-3.4-3.3 0-2.3 2.4-4.7 5.4-4.7Z" />
				</g>
			)
		}

		{
			slug === "dental-clinic" && (
				<path d="M12 4.2c-1.4 0-2.1.6-3.5.6-1.7 0-3.1 1.2-3.1 3.5 0 3 1.1 4.7 1.8 7.2.4 1.8.5 5.1 2.3 5.1 1.5 0 1.4-3.8 2.5-3.8s1 3.8 2.5 3.8c1.8 0 1.9-3.3 2.3-5.1.7-2.5 1.8-4.2 1.8-7.2 0-2.3-1.4-3.5-3.1-3.5-1.4 0-2.1-.6-3.5-.6Z" />
			)
		}

		{
			slug === "cafe" && (
				<g>
					<path d="M4 5.4h11.2v5.9a5.6 5.6 0 1 1-11.2 0V5.4Z" />
					<path d="M15.2 6.9h1.5a2.7 2.7 0 0 1 0 5.4h-1.5" />
					<path d="M3 20.4h13.4" />
				</g>
			)
		}

		{
			slug === "food-truck" && (
				<g>
					<path d="M2.6 6.6h10.1v9.2H2.6z" />
					<path d="M12.7 9.9h4.1l2.9 3v2.9h-7z" />
					<circle cx="7" cy="18.1" r="2.1" />
					<circle cx="16.2" cy="18.1" r="2.1" />
				</g>
			)
		}

		{
			slug === "bookkeeper" && (
				<g>
					<rect x="5" y="2.8" width="14" height="18.4" rx="1.8" />
					<path d="M8.2 6.6h7.6v3.1H8.2z" />
					<path d="M8.6 13.4h.01M12 13.4h.01M15.4 13.4h.01M8.6 17.2h.01M12 17.2h.01M15.4 17.2h.01" />
				</g>
			)
		}

		{
			slug === "yoga-studio" && (
				<g>
					<circle cx="12" cy="5.4" r="2.3" />
					<path d="M12 8.4v4.2" />
					<path d="M12 12.6c-2.7 0-5.3 2.2-7.6 6.2M12 12.6c2.7 0 5.3 2.2 7.6 6.2" />
					<path d="M4.4 18.8h15.2" />
				</g>
			)
		}

		{
			slug === "therapist" && (
				<g>
					<path d="M3.2 5.6h12.2a1.6 1.6 0 0 1 1.6 1.6v5.4a1.6 1.6 0 0 1-1.6 1.6H8.6L4.4 17.6v-3.4h-1.2a1.6 1.6 0 0 1-1.6-1.6V7.2a1.6 1.6 0 0 1 1.6-1.6Z" />
					<path d="M19.4 9.4a2.6 2.6 0 0 1 2.6 2.6v3a2.6 2.6 0 0 1-2.6 2.6v2.6l-3-2.6" />
				</g>
			)
		}

		{
			slug === "notary" && (
				<g>
					<circle cx="12" cy="8.8" r="5.8" />
					<path d="M12 5.8l.9 1.9 2 .3-1.5 1.4.4 2-1.8-1-1.8 1 .4-2L9.1 8l2-.3.9-1.9Z" />
					<path d="M8.9 13.9 8 21.4l4-2.2 4 2.2-.9-7.5" />
				</g>
			)
		}
	</svg>
</span>

<style>
	.tile {
		display: grid;
		place-items: center;
		width: var(--tile);
		height: var(--tile);
		border-radius: calc(var(--tile) * 0.29);
		background: linear-gradient(150deg, var(--brand-lift, #4a7fb5), var(--brand, #14507d));
		color: #fff;
		box-shadow: var(--shadow-lift);
	}

	.tile svg {
		width: 52%;
		height: 52%;
	}
</style>
