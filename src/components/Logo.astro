---
// The Basic Page mark: one page, torn off along the bottom.
//
// It is the same scalloped tear used on the receipt card and the closing band,
// shrunk to a mark, so the logo and the page are drawn with the same device.
//
// Two colours, both inherited, which is what makes it drop anywhere:
//   currentColor  the page itself
//   --logo-knock  the two lines, knocked out to match whatever is behind it
// On a coloured surface set --logo-knock to that surface colour.
interface Props {
	/** Rendered size of the mark in px. Legible down to 16. */
	size?: number;
	/** Show the "The Basic Page" wordmark beside the mark. */
	wordmark?: boolean;
	/** Font size of the wordmark in px. Defaults to a ratio of the mark. */
	wordmarkSize?: number;
	class?: string;
}

const { size = 24, wordmark = false, wordmarkSize, class: cls = "" } = Astro.props;
const ws = wordmarkSize ?? Math.round(size * 0.72);
---

<span class:list={["logo", cls]} style={`--logo-size:${size}px; --logo-word:${ws}px`}>
	<svg
		class="logo__mark"
		viewBox="0 0 64 64"
		fill="none"
		role="img"
		aria-label={wordmark ? null : "The Basic Page"}
		aria-hidden={wordmark ? "true" : null}
	>
		<g fill="currentColor">
			<rect x="12" y="11" width="40" height="36" rx="5"></rect>
			<circle cx="17" cy="47" r="5"></circle>
			<circle cx="27" cy="47" r="5"></circle>
			<circle cx="37" cy="47" r="5"></circle>
			<circle cx="47" cy="47" r="5"></circle>
		</g>
		<g fill="var(--logo-knock, #fff)">
			<rect x="19" y="20" width="26" height="6" rx="3"></rect>
			<rect x="19" y="31" width="16" height="4.5" rx="2.25"></rect>
		</g>
	</svg>
	{wordmark && <span class="logo__word">The Basic Page</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--logo-size) * 0.3);
		line-height: 1;
	}

	.logo__mark {
		width: var(--logo-size);
		height: var(--logo-size);
		flex: none;
	}

	.logo__word {
		font-family: var(--display, "Bricolage Grotesque", sans-serif);
		font-weight: 800;
		font-size: var(--logo-word);
		letter-spacing: -0.045em;
		white-space: nowrap;
	}
</style>
