---
import "../styles/global.css";
import { CONTACT, PRICE, SITE_TITLE, SITE_URL, telHref } from "../consts";
import { FAQS } from "../faq";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = "/og.png" } = Astro.props;
const ogImage = new URL(image, Astro.site ?? SITE_URL);

// Structured data. This is the part that lets a search engine — or an
// assistant answering "who builds cheap websites for small businesses" —
// state our offer correctly instead of guessing at it. We sell this to
// customers, so we do it on our own page first.
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfessionalService",
			"@id": `${SITE_URL}/#business`,
			name: SITE_TITLE,
			url: SITE_URL,
			description,
			email: CONTACT.email,
			...(CONTACT.phone ? { telephone: telHref(CONTACT.phone).replace("tel:", "") } : {}),
			priceRange: "$$",
			knowsAbout: [
				"small business websites",
				"one page websites",
				"same day website build",
				"Google Business Profile setup",
				"local SEO",
			],
			makesOffer: [
				{
					"@type": "Offer",
					name: "One-page website, built and live the same business day",
					price: PRICE.build,
					priceCurrency: "CAD",
					availability: "https://schema.org/InStock",
					itemOffered: {
						"@type": "Service",
						name: "One-page small business website",
						serviceType: "Website design and development",
						description:
							"A single, well-written page for a small business: services, service area, " +
							"hours, photos, and a tap-to-call phone number. Built and published the same " +
							"business day, with the domain connected and the Google Business Profile set " +
							"up. No login and no CMS — changes are requested by text or email.",
					},
				},
			],
		},
		{
			"@type": "WebSite",
			"@id": `${SITE_URL}/#website`,
			url: SITE_URL,
			name: SITE_TITLE,
			description,
			publisher: { "@id": `${SITE_URL}/#business` },
			inLanguage: "en-CA",
		},
		{
			"@type": "FAQPage",
			"@id": `${SITE_URL}/#faq`,
			mainEntity: FAQS.map((f) => ({
				"@type": "Question",
				name: f.q,
				acceptedAnswer: { "@type": "Answer", text: f.a },
			})),
		},
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#38bdf8" />

<!-- Fonts are self-hosted and subset; fetch them alongside the CSS. -->
<link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_CA" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
